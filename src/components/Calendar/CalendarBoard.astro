---

<main class="calendar-section hidden" id="calendarSection">
    <!-- Navigation Group (Title, Prev/Next) -->
    <div class="nav-group-right">
        <div class="nav-center-group">
            <div
                class="title-row"
                style="display: flex; align-items: baseline; justify-content: center;"
            >
                <button class="btn-today-quick" id="btnTodayQuick"
                    >回到今日</button
                >
                <div id="calendarTitle" class="calendar-title"></div>
            </div>
        </div>
    </div>

    <!-- Week Header -->
    <div class="week-header">
        <div>日</div>
        <div>一</div>
        <div>二</div>
        <div>三</div>
        <div>四</div>
        <div>五</div>
        <div>六</div>
    </div>

    <!-- Grid Container -->
    <div class="days-grid" id="calendarGrid">
        <!-- JS Grid Items -->
    </div>
</main>

<script is:inline>
    const grid = document.getElementById("calendarGrid");
    const calendarTitle = document.getElementById("calendarTitle");
    const calendarSection = document.getElementById("calendarSection");
    const SWIPE_THRESHOLD_PX = 50;

    // State (Received via props/attributes or initialized here if self-contained)
    // For now we assume main orchestrator passes state, or we manage local state and emit changes.
    // Let's keep state managed by orchestrator (index.astro) or shared store for simplicity?
    // Actually, to fully componentize, CalendarBoard should render based on inputs.
    // But since we are using Vanilla JS (no React/Vue), we update DOM imperatively.

    let _prevRenderedMonth = null;
    let _prevRenderedYear = null;

    function renderCalendar(year, month, today, selectedDay = null) {
        // Determine animation direction
        let animationClass = "";
        if (_prevRenderedMonth !== null) {
            const currentTotal = year * 12 + month;
            const prevTotal = _prevRenderedYear * 12 + _prevRenderedMonth;
            if (currentTotal > prevTotal)
                animationClass = "animate-slide-right";
            else if (currentTotal < prevTotal)
                animationClass = "animate-slide-left";
        }
        _prevRenderedMonth = month;
        _prevRenderedYear = year;

        // Apply fade-out before rendering new content?
        // Actually, let's just apply the animation to the new content.
        grid.className = "days-grid"; // Reset
        if (animationClass) {
            grid.classList.add(animationClass);
            // Remove class after animation ends to allow re-trigger
            grid.onanimationend = () => grid.classList.remove(animationClass);
        }

        grid.textContent = "";
        const fragment = document.createDocumentFragment();
        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const startDay = firstDay.getDay();

        // Leading padding (Prev Month)
        const prevMonthLast = new Date(year, month, 0).getDate();
        for (let i = startDay - 1; i >= 0; i--) {
            const day = prevMonthLast - i;
            fragment.appendChild(
                createDayCell(year, month - 1, day, true, today, selectedDay),
            );
        }

        // Current Month
        for (let day = 1; day <= lastDay.getDate(); day++) {
            fragment.appendChild(
                createDayCell(year, month, day, false, today, selectedDay),
            );
        }

        // Trailing padding (Next Month) - Fill to complete 5 or 6 rows (35 or 42 cells)
        // Trailing padding (Next Month) - Fill to complete 5 or 6 rows (35 or 42 cells)
        const totalCells = startDay + lastDay.getDate();
        const targetCells = totalCells <= 35 ? 35 : 42;
        const trailingDays = targetCells - totalCells;

        for (let day = 1; day <= trailingDays; day++) {
            fragment.appendChild(
                createDayCell(year, month + 1, day, true, today, selectedDay),
            );
        }

        grid.appendChild(fragment);
    }

    function createDayCell(year, month, day, isOtherMonth, today, selectedDay) {
        const date = new Date(year, month, day);
        const lunar = Lunar.fromDate(date);
        const term = lunar.getJieQi();
        const festival = lunar.getFestival() || lunar.getSolarFestival();

        const cell = document.createElement("div");

        cell.className = `day-cell ${isOtherMonth ? "other-month" : ""}`;
        cell.tabIndex = isOtherMonth ? -1 : 0;
        cell.setAttribute("role", "button");
        cell.dataset.year = year;
        cell.dataset.month = month;
        cell.dataset.day = day;
        if (isOtherMonth) cell.dataset.other = "true";

        if (date.toDateString() === today.toDateString())
            cell.classList.add("today");

        // Maintain selection state if not other month
        if (!isOtherMonth && selectedDay && day === selectedDay) {
            cell.classList.add("selected");
        }

        const greg = document.createElement("div");
        greg.className = "gregorian-num";
        greg.textContent = day;

        const lunarDiv = document.createElement("div");
        lunarDiv.className = "lunar-text";
        const lunarDateStr = lunar.getDayInChinese();
        let bottomText = lunarDateStr;
        if (festival) {
            bottomText = festival;
            lunarDiv.style.color = "#ff6b6b";
        } else if (term) {
            bottomText = term;
            lunarDiv.style.color = "#e6d5a7"; // Terms in Gold
        }
        lunarDiv.textContent = bottomText;

        cell.appendChild(greg);
        cell.appendChild(lunarDiv);

        if (term && !isOtherMonth) {
            const dot = document.createElement("div");
            dot.className = "term-dot";
            cell.appendChild(dot);
        }

        cell.setAttribute(
            "aria-label",
            `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日 · ${bottomText}`,
        );

        return cell;
    }

    // Event Listeners
    let longPressFired = false;

    grid.addEventListener("click", (e) => {
        const cell = e.target.closest(".day-cell");
        if (!cell) return;

        // Ensure long press doesn't block legitimate clicks if logic is fuzzy
        if (longPressFired) {
            longPressFired = false;
            return;
        }

        // Stop bubbling to prevent FloatingPanels from immediately closing the panel
        e.stopPropagation();

        const day = parseInt(cell.dataset.day);
        const year = parseInt(cell.dataset.year);
        const month = parseInt(cell.dataset.month);

        // Visual Feedback
        grid.querySelectorAll(".day-cell").forEach((c) =>
            c.classList.remove("selected"),
        );
        cell.classList.add("selected");

        console.log(`[Calendar] Date Selected: ${year}-${month + 1}-${day}`);
        window.dispatchEvent(
            new CustomEvent("date-selected", { detail: { year, month, day } }),
        );
    });

    // Swipe
    let touchStartX = 0;
    calendarSection.addEventListener(
        "touchstart",
        (e) => (touchStartX = e.changedTouches[0].screenX),
        { passive: true },
    );
    calendarSection.addEventListener(
        "touchend",
        (e) => {
            const diff = e.changedTouches[0].screenX - touchStartX;
            if (Math.abs(diff) > SWIPE_THRESHOLD_PX) {
                window.dispatchEvent(
                    new CustomEvent("navigate-month", {
                        detail: diff > 0 ? -1 : 1,
                    }),
                );
            }
        },
        { passive: true },
    );

    document.getElementById("btnTodayQuick").onclick = () =>
        window.dispatchEvent(new CustomEvent("go-to-today"));

    // Long Press
    // Long Press Logic - Disabled temporarily to debug click issues
    /*
    grid.addEventListener(
        "pointerdown",
        (e) => {
            const cell = e.target.closest(".day-cell");
            if (!cell || cell.dataset.other) return;
            const y = parseInt(cell.dataset.year);
            const m = parseInt(cell.dataset.month);
            const d = parseInt(cell.dataset.day);
            const date = new Date(y, m, d);
            const lunar = Lunar.fromDate(date);
            longPressTimer = setTimeout(() => {
                longPressFired = true;
                handleLongPress(date, lunar);
            }, LONG_PRESS_MS);
        },
        { passive: false },
    );

    const cancelLongPress = () => {
        if (longPressTimer) {
            clearTimeout(longPressTimer);
            longPressTimer = null;
        }
    };
    grid.addEventListener("pointerup", cancelLongPress);
    grid.addEventListener("pointerleave", cancelLongPress);
    */

    // eslint-disable-next-line no-unused-vars
    async function handleLongPress(date, lunar) {
        const title = `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, "0")}-${date.getDate()}`;
        const text = `農曆 ${lunar.getMonthInChinese()}${lunar.getDayInChinese()}`;
        if (navigator.share) {
            try {
                await navigator.share({ title, text });
            } catch (e) {
                console.error("Share failed", e);
            }
        } else if (navigator.clipboard) {
            try {
                await navigator.clipboard.writeText(`${title} ${text}`);
                alert("已複製日期資訊到剪貼簿");
            } catch (e) {
                console.error("Clipboard copy failed", e);
            }
        }
    }

    // Expose render function or listen to update events
    window.addEventListener("render-calendar", (e) => {
        const { year, month, today, selectedDay } = e.detail;
        renderCalendar(year, month, today, selectedDay);
    });

    window.addEventListener("update-calendar-title", (e) => {
        const { lunarText } = e.detail;
        if (lunarText) {
            // Helper to convert special Lunar month names to standard numbers equivalent
            // if user prefers "Normal Chinese Characters" (e.g. 臘 -> 十二, 正 -> 一)
            const mapMonth = (m) => {
                if (m === "正") return "一";
                if (m === "冬") return "十一";
                if (m === "臘") return "十二";
                return m;
            };

            const displayMonth = mapMonth(lunarText.month);

            calendarTitle.textContent = `${lunarText.ganzhi}年 · ${displayMonth}月 · ${lunarText.day}`;
        }
    });

    window.addEventListener("toggle-grid-view", (e) => {
        const { show } = e.detail;
        if (show) {
            calendarSection.classList.remove("hidden");
            // Force reflow to ensure transition happens
            void calendarSection.offsetWidth;
            calendarSection.classList.add("show-grid");
        } else {
            calendarSection.classList.remove("show-grid");
            // Wait for transition to finish before hiding (0.5s match CSS)
            // Or use transitionend event
            const onTransitionEnd = () => {
                if (!calendarSection.classList.contains("show-grid")) {
                    calendarSection.classList.add("hidden");
                }
                calendarSection.removeEventListener(
                    "transitionend",
                    onTransitionEnd,
                );
            };
            calendarSection.addEventListener("transitionend", onTransitionEnd);

            // Backup timeout in case transitionend doesn't fire (e.g. if hidden)
            setTimeout(onTransitionEnd, 550);
        }
    });
</script>
