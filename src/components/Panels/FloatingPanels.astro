---

---

<!-- Floating Panels -->
<div
    id="panelBackOverlay"
    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 1000; cursor: pointer;"
>
</div>
<div
    id="panelYearMonth"
    class="suspension-panel"
    style="display: none; z-index: 1001;"
>
    <!-- Generated by JS -->
</div>
<div
    id="panelToday"
    class="suspension-panel"
    style="display: none; z-index: 1001; cursor: pointer;"
>
    <!-- Generated by JS -->
</div>

<script is:inline>
    const panelYearMonth = document.getElementById("panelYearMonth");
    const panelToday = document.getElementById("panelToday");

    function renderYearMonthPanel(
        selectedYear,
        selectedMonth,
        selectedDay,
        today,
    ) {
        panelYearMonth.innerHTML = "";
        const container = document.createElement("div");
        container.className = "panel-section-container";

        // Year Section
        const yearSection = document.createElement("div");
        const yearHeader = document.createElement("div");
        yearHeader.className = "panel-section-header";
        yearHeader.textContent = "年份";
        yearSection.appendChild(yearHeader);

        const yearGrid = document.createElement("div");
        yearGrid.className = "panel-grid";
        const startYear = selectedYear - 4;
        for (let i = 0; i < 12; i++) {
            const y = startYear + i;
            const item = document.createElement("div");
            item.className = `panel-item ${y === selectedYear ? "selected" : ""} ${y === today.getFullYear() ? "today" : ""}`;
            item.textContent = y;
            item.onclick = (e) => {
                e.stopPropagation();
                window.dispatchEvent(
                    new CustomEvent("year-selected", { detail: y }),
                );
            };
            yearGrid.appendChild(item);
        }
        yearSection.appendChild(yearGrid);
        container.appendChild(yearSection);

        // Divider
        const divider = document.createElement("div");
        divider.className = "panel-section-divider";
        container.appendChild(divider);

        // Month Section
        const monthSection = document.createElement("div");
        const monthHeader = document.createElement("div");
        monthHeader.className = "panel-section-header";
        monthHeader.textContent = "月份";
        monthSection.appendChild(monthHeader);

        const monthGrid = document.createElement("div");
        monthGrid.className = "panel-grid";
        for (let i = 0; i < 12; i++) {
            const isTodayMonth =
                selectedYear === today.getFullYear() && i === today.getMonth();
            const item = document.createElement("div");
            item.className = `panel-item ${i === selectedMonth ? "selected" : ""} ${isTodayMonth ? "today" : ""}`;
            // Use spans for styling: Number (Serif) + Label (Calligraphy)
            item.innerHTML = `<span class="month-num">${i + 1}</span><span class="month-label">月</span>`;
            item.onclick = (e) => {
                e.stopPropagation();
                window.dispatchEvent(
                    new CustomEvent("month-selected", { detail: i }),
                );
            };
            monthGrid.appendChild(item);
        }
        monthSection.appendChild(monthGrid);
        container.appendChild(monthSection);

        panelYearMonth.appendChild(container);
    }

    function renderTodayPanel(selectedYear, selectedMonth, selectedDay) {
        const date = new Date(selectedYear, selectedMonth, selectedDay);
        const lunar = Lunar.fromDate(date);
        const monthText = lunar.getMonthInChinese();
        const dayText = lunar.getDayInChinese();
        const ganzhi = lunar.getYearInGanZhi();
        const zodiac = lunar.getYearShengXiao();
        const dayGZ = lunar.getDayInGanZhi();
        const monthGZ = lunar.getMonthInGanZhi();
        const jianchu = lunar.getJianChu();
        const luck = lunar.getDayLuck();
        const termPeriod = lunar.getSolarTermPeriod();
        const yi = lunar.getDayYi();
        const ji = lunar.getDayJi();
        const festival = lunar.getFestival() || lunar.getSolarFestival();

        const festivalHtml = festival
            ? `<div class="detail-sub-main" style="color:#ff6b6b; margin-top:10px">${festival}</div>`
            : "";

        panelToday.innerHTML = `
    <div class="panel-side-accent">
        <div class="vertical-text">${ganzhi}年 · ${monthText}月${dayText}</div>
    </div>
    <div class="panel-main-content">
        <div class="detail-header-group" style="display:flex; justify-content:space-between; align-items:flex-start; border-left:none; padding-left:0;">
            <div>
                <div class="detail-header" style="margin-bottom:5px">${date.getMonth() + 1}/${date.getDate()}</div>
                <div class="detail-sub-main" style="font-size:1.2rem; opacity:0.7">${date.getFullYear()} · ${ganzhi}年</div>
            </div>
            <div class="traditional-seal">${zodiac.charAt(0)}</div>
        </div>
        
        <div class="detail-info-row" style="margin-top:-10px">
            <span>${monthGZ}月</span>
            <span>${dayGZ}日</span>
            <span style="color:#d4af37">${termPeriod.current}</span>
        </div>

        <div class="detail-lucky-pill">
            ${jianchu}日 · ${luck}
        </div>
        
        ${festivalHtml}
        
        <div class="detail-yiji">
            <div class="yiji-item">
                <span class="yiji-label yiji-label--good">宜</span>
                <div class="tag-container">
                    ${yi
                        .slice(0, 5)
                        .map((t) => `<span class="tag">${t}</span>`)
                        .join("")}
                    ${yi.length === 0 ? '<span class="tag">諸事平吉</span>' : ""}
                </div>
            </div>
            <div class="yiji-item">
                <span class="yiji-label yiji-label--bad">忌</span>
                <div class="tag-container">
                    ${ji
                        .slice(0, 5)
                        .map((t) => `<span class="tag">${t}</span>`)
                        .join("")}
                    ${ji.length === 0 ? '<span class="tag">諸事不忌</span>' : ""}
                </div>
            </div>
        </div>
    </div>`;
    }

    const panelBackOverlay = document.getElementById("panelBackOverlay");

    window.addEventListener("render-panels", (e) => {
        const { type, selectedYear, selectedMonth, selectedDay, today } =
            e.detail;

        if (type === "yearMonth") {
            const todayObj = new Date(today);
            renderYearMonthPanel(
                selectedYear,
                selectedMonth,
                selectedDay,
                todayObj,
            );
            panelYearMonth.style.display = "block";
            panelYearMonth.classList.add("bottom-panel");
            panelBackOverlay.style.display = "block";
        } else if (type === "today") {
            try {
                renderTodayPanel(selectedYear, selectedMonth, selectedDay);
                panelToday.style.display = "flex"; // Match CSS flex layout
                panelToday.classList.add("bottom-panel");
                panelBackOverlay.style.display = "block";
            } catch (err) {
                console.error("[Floater] Error rendering today panel:", err);
                panelToday.innerHTML = `<div style="padding:20px;text-align:center;">載入失敗，請稍後再試</div>`;
                panelToday.style.display = "block";
                panelBackOverlay.style.display = "block";
            }
        }
    });

    window.addEventListener("hide-panels", () => {
        panelYearMonth.style.display = "none";
        panelToday.style.display = "none";
        panelBackOverlay.style.display = "none";
    });

    // Handle Click on Overlay or Today Panel directly to return to Grid
    const handleClosePanel = () => {
        // Exit Welcome Mode if active
        window.dispatchEvent(
            new CustomEvent("welcome-mode", { detail: { active: false } }),
        );
        // Close self and return to Grid
        window.dispatchEvent(
            new CustomEvent("close-panels", { detail: { showGrid: true } }),
        );
    };

    panelBackOverlay.onclick = handleClosePanel;
    panelToday.onclick = handleClosePanel;

    // Global Click Listener for Closing Panels (Backwards compatibility / Outer areas)
    document.addEventListener("click", (e) => {
        const isYearMonthVisible = panelYearMonth.style.display === "block";
        const isTodayVisible =
            panelToday.style.display === "block" ||
            panelToday.style.display === "flex";

        if (isYearMonthVisible || isTodayVisible) {
            const target = e.target;
            // Year Month panel should probably NOT close when clicking inside it if we want users to select dates
            if (isYearMonthVisible && target.closest("#panelYearMonth")) return;

            // If clicking a nav button, ignore (they handle their own events)
            if (target.closest(".nav-box") || target.closest(".dock-item"))
                return;

            // Otherwise (clicking background/page), close panels and Show Grid
            handleClosePanel();
        }
    });
</script>
