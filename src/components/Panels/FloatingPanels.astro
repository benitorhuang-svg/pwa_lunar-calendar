---

<!-- Floating Panels -->
<div id="panelYearMonth" class="suspension-panel">
    <!-- Generated by JS -->
</div>
<div id="panelToday" class="suspension-panel">
    <!-- Generated by JS -->
</div>

<script is:inline>
    const panelYearMonth = document.getElementById("panelYearMonth");
    const panelToday = document.getElementById("panelToday");

    function renderYearMonthPanel(
        selectedYear,
        selectedMonth,
        selectedDay,
        today,
    ) {
        panelYearMonth.innerHTML = "";
        const container = document.createElement("div");
        container.className = "panel-section-container";

        // Year Section
        const yearSection = document.createElement("div");
        const yearHeader = document.createElement("div");
        yearHeader.className = "panel-section-header";
        yearHeader.textContent = "年份";
        yearSection.appendChild(yearHeader);

        const yearGrid = document.createElement("div");
        yearGrid.className = "panel-grid";
        const startYear = selectedYear - 4;
        for (let i = 0; i < 12; i++) {
            const y = startYear + i;
            const item = document.createElement("div");
            item.className = `panel-item ${y === selectedYear ? "selected" : ""} ${y === today.getFullYear() ? "today" : ""}`;
            item.textContent = y;
            item.onclick = (e) => {
                e.stopPropagation();
                window.dispatchEvent(
                    new CustomEvent("year-selected", { detail: y }),
                );
            };
            yearGrid.appendChild(item);
        }
        yearSection.appendChild(yearGrid);
        container.appendChild(yearSection);

        // Month Section
        const monthSection = document.createElement("div");
        const monthHeader = document.createElement("div");
        monthHeader.className = "panel-section-header";
        monthHeader.textContent = "月份";
        monthSection.appendChild(monthHeader);

        const monthGrid = document.createElement("div");
        monthGrid.className = "panel-grid";
        for (let i = 0; i < 12; i++) {
            const isTodayMonth =
                selectedYear === today.getFullYear() && i === today.getMonth();
            const item = document.createElement("div");
            item.className = `panel-item ${i === selectedMonth ? "selected" : ""} ${isTodayMonth ? "today" : ""}`;
            item.textContent = i + 1 + "月";
            item.onclick = (e) => {
                e.stopPropagation();
                window.dispatchEvent(
                    new CustomEvent("month-selected", { detail: i }),
                );
            };
            monthGrid.appendChild(item);
        }
        monthSection.appendChild(monthGrid);
        container.appendChild(monthSection);

        panelYearMonth.appendChild(container);
    }

    function renderTodayPanel(selectedYear, selectedMonth, selectedDay) {
        const date = new Date(selectedYear, selectedMonth, selectedDay);
        const lunar = Lunar.fromDate(date);
        const monthText = lunar.getMonthInChinese();
        const dayText = lunar.getDayInChinese();
        const ganzhi = lunar.getYearInGanZhi();
        const zodiac = lunar.getYearShengXiao();
        const dayGZ = lunar.getDayInGanZhi();
        const monthGZ = lunar.getMonthInGanZhi();
        const jianchu = lunar.getJianChu();
        const luck = lunar.getDayLuck();
        const termPeriod = lunar.getSolarTermPeriod();
        const yi = lunar.getDayYi();
        const ji = lunar.getDayJi();
        const festival = lunar.getFestival() || lunar.getSolarFestival();

        const festivalHtml = festival
            ? `<div class="detail-sub" style="color:var(--primary-red);font-weight:600">🎉 ${festival}</div>`
            : "";

        panelToday.innerHTML = `
    <div class="detail-content">
        <div class="detail-header">${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日</div>
        <div class="detail-sub" style="color:var(--gold-accent)">${zodiac}年 · ${monthText}月${dayText}</div>
        <div class="detail-sub" style="font-size:0.9rem; opacity:0.6">${ganzhi}年 · ${monthGZ}月 · ${dayGZ}日</div>
        <div class="detail-sub" style="font-size:0.95rem">${jianchu}日 · ${luck} · ${termPeriod.current}～${termPeriod.next}</div>
        ${festivalHtml}
        <div class="detail-yiji">
            <div class="tag-list">
                <span class="yiji-label yiji-label--bad"><span>🚫</span> 忌</span>
                ${ji
                    .slice(0, 6)
                    .map((t) => `<span class="tag bad-styled">${t}</span>`)
                    .join("")}
                ${ji.length === 0 ? '<span class="tag bad-styled">諸事不宜</span>' : ""}
            </div>
            <div class="tag-list">
                <span class="yiji-label"><span>✅</span> 宜</span>
                ${yi
                    .slice(0, 6)
                    .map((t) => `<span class="tag good">${t}</span>`)
                    .join("")}
                ${yi.length === 0 ? '<span class="tag good">普普通通</span>' : ""}
            </div>
        </div>
    </div>`;
    }

    window.addEventListener("render-panels", (e) => {
        const { type, selectedYear, selectedMonth, selectedDay, today } =
            e.detail;

        if (type === "yearMonth") {
            const todayObj = new Date(today);
            renderYearMonthPanel(
                selectedYear,
                selectedMonth,
                selectedDay,
                todayObj,
            );
            panelYearMonth.style.display = "block";
            panelYearMonth.classList.add("bottom-panel");
        } else if (type === "today") {
            console.log("[Floater] Rendering Today Panel");
            try {
                renderTodayPanel(selectedYear, selectedMonth, selectedDay);
                panelToday.style.display = "block";
                panelToday.classList.add("bottom-panel");
                console.log("[Floater] Panel style set to block");
            } catch (err) {
                console.error("[Floater] Error rendering today panel:", err);
                panelToday.innerHTML = `<div style="padding:20px;text-align:center;">載入失敗，請稍後再試</div>`;
                panelToday.style.display = "block";
            }
        }
    });

    window.addEventListener("close-panels-view", () => {
        panelYearMonth.style.display = "none";
        panelToday.style.display = "none";
    });

    // Global Click Listener for Closing Panels
    document.addEventListener("click", (e) => {
        const isYearMonthVisible = panelYearMonth.style.display === "block";
        const isTodayVisible = panelToday.style.display === "block";

        if (isYearMonthVisible || isTodayVisible) {
            const target = e.target;
            // If clicking inside a panel, ignore
            if (target.closest(".suspension-panel")) return;
            // If clicking a nav button, ignore (they handle their own events)
            if (target.closest(".nav-box")) return;

            // Otherwise (clicking background/page), close panels and Show Grid (User Req 1)
            window.dispatchEvent(
                new CustomEvent("close-panels", { detail: { showGrid: true } }),
            );
        }
    });
</script>
