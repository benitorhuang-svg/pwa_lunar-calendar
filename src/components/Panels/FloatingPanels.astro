---
import "../../styles/panels.css";
---

<!-- Floating Panels -->
<div class="panel-back-overlay" id="panelBackOverlay"></div>

<div class="suspension-panel glass-card-template" id="panelYearMonth">
    <!-- Generated by JS -->
</div>

<div class="suspension-panel glass-card-template" id="panelToday">
    <!-- Generated by JS -->
</div>

<div class="suspension-panel glass-card-template" id="panelFAQ">
    <!-- Generated FAQ content (populated by JS) -->
</div>

<!-- Note Pad Overlay -->
<div class="note-pad-overlay" id="notePadOverlay">
    <div class="note-pad-header">
        <div class="note-header-left">
            <span class="note-pad-title">每日記事</span>
            <div class="note-date-wrapper">
                <input type="date" id="noteDatePicker" class="note-date-input" />
                <div class="note-date-display">
                    <svg
                        fill="none"
                        height="18"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="18"
                    >
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span id="noteDateText">日期</span>
                </div>
                <!-- Custom Date Picker -->
                <div class="custom-date-picker" id="customDatePicker">
                    <div class="picker-header">
                        <button class="picker-nav-btn" id="pickerPrevBtn" type="button">
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </button>
                        <span class="picker-current-month" id="pickerMonthDisplay">2026年 2月</span>
                        <button class="picker-nav-btn" id="pickerNextBtn" type="button">
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </button>
                    </div>
                    <div class="picker-weekdays">
                        <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span
                        ><span>五</span><span>六</span>
                    </div>
                    <div class="picker-grid" id="pickerGrid">
                        <!-- Days generated by JS -->
                    </div>
                </div>
            </div>
        </div>
        <div class="note-actions">
            <button
                aria-label="列表"
                class="note-action-btn"
                id="btnNoteList"
                type="button"
                title="歷史紀錄"
            >
                <svg
                    fill="none"
                    height="20"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="20"
                >
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
            </button>
            <button
                aria-label="存檔"
                class="note-action-btn"
                id="btnNoteSave"
                type="button"
                title="存檔"
            >
                <svg
                    fill="none"
                    height="20"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="20"
                >
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"
                    ></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
            </button>
        </div>
    </div>
    <div class="note-pad-body">
        <div id="noteEditorContainer" class="note-view-container">
            <!-- Editor Toolbar -->
            <div class="note-editor-toolbar">
                <button class="note-tool-btn" id="btnNoteToday" type="button" title="回到今天">
                    <svg
                        fill="none"
                        height="14"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="14"
                    >
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>今天</span>
                </button>
                <button class="note-tool-btn" id="btnNotePin" type="button" title="置頂">
                    <svg
                        fill="none"
                        height="14"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="14"
                    >
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"
                        ></path>
                    </svg>
                    <span>置頂</span>
                </button>
                <button class="note-tool-btn" id="btnNoteExport" type="button" title="匯出全部筆記">
                    <svg
                        fill="none"
                        height="14"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="14"
                    >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>匯出</span>
                </button>
                <button
                    class="note-tool-btn danger"
                    id="btnNoteClear"
                    type="button"
                    title="清除內容"
                >
                    <svg
                        fill="none"
                        height="14"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="14"
                    >
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path
                            d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                        ></path>
                    </svg>
                    <span>清除</span>
                </button>
            </div>
            <textarea
                class="note-pad-textarea"
                id="noteTextarea"
                placeholder="寫下今日的想法或是行程..."></textarea>
            <!-- Tag Bar -->
            <div class="note-tag-bar" id="noteTagBar">
                <div class="note-current-tags" id="noteCurrentTags"></div>
                <div class="note-tag-presets" id="noteTagPresets">
                    <!-- Preset tag buttons generated by JS -->
                </div>
                <div class="note-tag-custom">
                    <input
                        type="text"
                        id="noteTagInput"
                        class="note-tag-input"
                        placeholder="+ 自訂標籤"
                        maxlength="10"
                    />
                </div>
            </div>
            <!-- Character Count -->
            <div class="note-char-count" id="noteCharCount">0 字</div>
        </div>
        <div id="noteListContainer" class="note-view-container hidden">
            <!-- Search Bar -->
            <div class="note-search-bar">
                <svg
                    fill="none"
                    height="16"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="16"
                >
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input
                    type="text"
                    id="noteSearchInput"
                    class="note-search-input"
                    placeholder="搜尋筆記..."
                />
            </div>
            <!-- Tag Filter -->
            <div class="note-tag-filter" id="noteTagFilter">
                <button class="tag-filter-btn active" data-tag="all" type="button">全部</button>
                <!-- Preset filter buttons generated by JS -->
            </div>
            <!-- Note Count -->
            <div class="note-list-info" id="noteListInfo">共 0 筆紀錄</div>
            <!-- List populated by JS -->
            <div class="note-list-scroll" id="noteListScroll"></div>
        </div>
    </div>
</div>

<script src="../../scripts/panels/floating-panels.ts"></script>
<script src="../../scripts/ui/faq.ts"></script>
