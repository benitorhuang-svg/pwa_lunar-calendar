---
import HeroBackground from "./HeroBackground.astro";
import WelcomeOverlay from "./WelcomeOverlay.astro";
import HeroHeader from "./HeroHeader.astro";
import HeroDock from "./HeroDock.astro";
import MusicPlayer from "./MusicPlayer.astro";
---

<HeroBackground />
<WelcomeOverlay />
<HeroHeader />
<HeroDock />
<MusicPlayer />

<script is:inline>
    // Hero images — organized by seasons in assets/gallery/
    const baseDir = window.APP_BASE_URL || "/";
    const BASE_HERO_DIR = (baseDir + "assets/gallery/").replace(/\/+/g, "/");
    var heroList = [];
    var _heroIdx = 0;
    var _requestedSeason = null; // last season we tried to load
    var _currentSpecialName = null;
    var _specialHeroList = [];
    var _specialHeroIdx = 0;
    window.slideshowTimer = null;
    window.idleTimer = null;
    const SLIDESHOW_INTERVAL_MS = 10000;
    const SLIDESHOW_IDLE_TIMEOUT = 10000; // 恢復 10 秒閒置
    var _isArtworkMode = false; // 明確標記當前是否為映畫模式

    function resetIdleTimer() {
        if (window.idleTimer) {
            clearTimeout(window.idleTimer);
            window.idleTimer = null;
        }

        const isInitialWelcome =
            document.body.classList.contains("initial-welcome");
        const isImmersion = document.body.classList.contains("immersion-mode");

        // 路線 A：啟動歡迎頁面 (只要有標記就計時)
        if (isInitialWelcome) {
            window.idleTimer = setTimeout(() => {
                if (document.body.classList.contains("initial-welcome")) {
                    console.log(
                        "[Route A] 1s idle reached: Hiding Welcome Card",
                    );
                    document.body.classList.remove("initial-welcome");
                    window.dispatchEvent(
                        new CustomEvent("welcome-mode", {
                            detail: { active: true },
                        }),
                    );
                }
            }, SLIDESHOW_IDLE_TIMEOUT);
        }
        // 路線 B：映畫模式 (且非沉浸時才計時)
        else if (_isArtworkMode && !isImmersion) {
            window.idleTimer = setTimeout(() => {
                console.log("[Route B] 1s idle reached: Hiding Artwork UI");
                window.dispatchEvent(
                    new CustomEvent("welcome-mode", {
                        detail: { active: true },
                    }),
                );
            }, SLIDESHOW_IDLE_TIMEOUT);
        }
    }

    // 監聽 DOM 變化，確保 initial-welcome 一出現就啟動計時
    const observer = new MutationObserver((mutations) => {
        mutations.forEach((m) => {
            if (
                m.attributeName === "class" &&
                document.body.classList.contains("initial-welcome")
            ) {
                resetIdleTimer();
            }
        });
    });
    observer.observe(document.body, { attributes: true });

    // 監控範圍：監聽螢幕觸碰與點擊
    ["mousedown", "touchstart"].forEach((evt) => {
        window.addEventListener(evt, resetIdleTimer, { passive: true });
    });

    // 滑鼠移動：僅在非歡迎畫面重置
    window.addEventListener(
        "mousemove",
        () => {
            if (document.body.classList.contains("initial-welcome")) return;
            resetIdleTimer();
        },
        { passive: true },
    );

    // DOM Elements
    const heroBgContainer = document.getElementById("heroBgContainer");
    const heroDockWrapper = document.querySelector(".hero-dock-wrapper");
    const heroHeader = document.querySelector(".hero-header");
    const welcomeOverlay = document.getElementById("welcomeInteractionOverlay");

    function getSeason(date) {
        const m = date.getMonth(); // 0-indexed
        if (m >= 2 && m <= 4) return "spring";
        if (m >= 5 && m <= 7) return "summer";
        if (m >= 8 && m <= 10) return "autumn";
        return "winter";
    }

    /* Helper: Check if image exists */
    function checkImageExists(src) {
        return new Promise((resolve) => {
            const img = new Image();
            img.onload = () => resolve(true);
            img.onerror = () => resolve(false);
            img.src = src;
        });
    }

    /**
     * Auto-detect hero images in the specific seasonal folder
     */
    async function detectHeroImages(season = "default", isFallback = false) {
        const seasonDir = `${BASE_HERO_DIR}${season}/`;
        let detected = [];

        // 1. Try to load from Global Manifest JS (Best for file:// protocol)
        if (typeof GALLERY_MANIFEST !== "undefined") {
            if (
                GALLERY_MANIFEST[season] &&
                GALLERY_MANIFEST[season].length > 0
            ) {
                detected = GALLERY_MANIFEST[season].map(
                    (filename) => `${seasonDir}${filename}`,
                );
                console.log(
                    `[Hero] Loaded ${detected.length} images from JS Manifest for ${season}`,
                );
            }
        }
        // 2. Try to load from JSON manifest (Best for local server / web)
        else {
            try {
                const response = await fetch("assets/gallery/gallery.json");
                if (response.ok) {
                    const manifest = await response.json();
                    if (manifest[season] && manifest[season].length > 0) {
                        detected = manifest[season].map(
                            (filename) => `${seasonDir}${filename}`,
                        );
                        console.log(
                            `[Hero] Loaded ${detected.length} images from JSON Manifest for ${season}`,
                        );
                    }
                }
            } catch {
                // Expected fail on file:// without local server
            }
        }

        // 3. Fallback to probing if manifest failed or returned empty
        if (detected.length === 0) {
            console.log(`[Hero] Probing images in: ${seasonDir}`);
            let i = 1;
            const maxProbe = 20; // Limit probing

            while (i <= maxProbe) {
                let found = false;
                const exts = [".png", ".webp", ".jpg"];
                for (const ext of exts) {
                    const src = `${seasonDir}${i}${ext}`;
                    try {
                        const exists = await new Promise((resolve) => {
                            const img = new Image();
                            img.onload = () => resolve(true);
                            img.onerror = () => resolve(false);
                            img.src = src;
                        });
                        if (exists) {
                            detected.push(src);
                            found = true;
                            i++;
                            break;
                        }
                    } catch {
                        // Ignore
                    }
                }
                if (!found) break;
            }
        }

        // Fallback to default gallery if no images found in seasonal folder
        if (detected.length === 0 && season !== "default") {
            console.log(
                `[Hero] No images in ${season}, falling back to default.`,
            );
            await detectHeroImages("default", true);
            if (!isFallback) /* keep requested season (no-op) */ null;
            return;
        }

        heroList =
            detected.length > 0 ? detected : [`${BASE_HERO_DIR}default/1.png`];
        // Shuffle
        heroList.sort(() => Math.random() - 0.5);

        _heroIdx = 0;
        _currentSeason = season;

        preloadHeroImages();

        // Only trigger update if this isn't a deep recursive call
        if (!isFallback) {
            window.dispatchEvent(new CustomEvent("request-hero-change"));
        }
    }

    const _heroCache = {};
    function preloadHeroImages() {
        heroList.forEach((src) => {
            const img = new Image();
            img.src = src;
            _heroCache[src] = img;
        });
    }

    /**
     * Switch Hero Image directly
     * @param {number} offset - -1 for previous, 1 for next
     * @param {boolean} isAuto - true if triggered by slideshow
     */
    function switchHero(offset, isAuto = false) {
        if (!isAuto && slideshowTimer) {
            resetSlideshow();
        }

        let list;
        let idx;
        let isSpecial = false;
        if (_specialHeroList && _specialHeroList.length > 0) {
            list = _specialHeroList;
            idx = _specialHeroIdx;
            isSpecial = true;
        } else {
            list = heroList;
            idx = _heroIdx;
        }

        let newIdx = idx + offset;
        if (newIdx >= list.length) newIdx = 0;
        if (newIdx < 0) newIdx = list.length - 1;

        if (isSpecial) {
            _specialHeroIdx = newIdx;
        } else {
            _heroIdx = newIdx;
        }

        // 統一使用 Cinema Fade
        // 自動切換使用標準 fade，手動點擊使用帶有方向感的 fade-next/prev
        const transType = isAuto
            ? "fade"
            : offset > 0
              ? "fade-next"
              : "fade-prev";

        setHeroBackground(list[newIdx], transType);

        window.dispatchEvent(
            new CustomEvent("close-panels", { detail: { showGrid: false } }),
        );
    }

    /**
     * Sets the background image with animation
     */
    function setHeroBackground(url, transition) {
        const newItem = document.createElement("div");
        newItem.className = "hero-bg-item";
        newItem.style.backgroundImage = `url('${url}')`;

        const currentItem = heroBgContainer.querySelector(
            ".hero-bg-item:last-child",
        );

        // 初始化狀態
        if (transition === "fade-next") {
            newItem.classList.add("is-next");
        } else if (transition === "fade-prev") {
            newItem.classList.add("is-prev");
        } else {
            // "fade" 或預設
            newItem.classList.add("is-new");
        }
        newItem.style.zIndex = "2";
        if (currentItem) currentItem.style.zIndex = "1";

        heroBgContainer.appendChild(newItem);
        newItem.offsetHeight; // Reflow

        requestAnimationFrame(() => {
            // 開始執行：新圖回歸 1.0 並淡入
            newItem.classList.remove("is-new", "is-next", "is-prev");

            if (currentItem) {
                // 舊圖霧化淡出
                currentItem.classList.add("blur-out");
                // 如果是方向性切換，舊圖也稍微加上對應的縮放位移
                if (transition === "fade-next")
                    currentItem.style.transform = "scale(0.95)";
                if (transition === "fade-prev")
                    currentItem.style.transform = "scale(1.05)";
            }

            setTimeout(() => {
                if (currentItem && currentItem.parentNode)
                    heroBgContainer.removeChild(currentItem);
                newItem.style.zIndex = "";
            }, 850);
        });
    }

    function startSlideshow() {
        if (window.slideshowTimer) return;
        if (_specialHeroList.length < 2 && heroList.length < 2) return;

        window.slideshowTimer = setInterval(() => {
            switchHero(1, true);
        }, SLIDESHOW_INTERVAL_MS);
    }

    function stopSlideshow() {
        if (window.slideshowTimer) {
            clearInterval(window.slideshowTimer);
            window.slideshowTimer = null;
        }
    }

    function resetSlideshow() {
        stopSlideshow();
        startSlideshow();
    }

    async function updateHeroLogic(changeBg, transitionOverride, date, lunar) {
        // 當次資料日期對應的季節
        const targetSeason = getSeason(date);
        // 如果季節改變了，重新探測該季節的圖庫
        if (targetSeason !== _requestedSeason) {
            _requestedSeason = targetSeason;
            await detectHeroImages(targetSeason);
            return; // detectHeroImages 會觸發 updateHero
        }

        const festival = lunar.getFestival();
        const term = lunar.getJieQi();
        const specialName = festival || term;

        let finalUrl = null;

        // Logic A: Festival/Term Multi-Image Support (Sequential Probing)
        if (specialName) {
            if (specialName !== _currentSpecialName) {
                _currentSpecialName = specialName;
                _specialHeroList = [];
                _specialHeroIdx = 0;

                const exts = [".png", ".webp", ".jpg"];

                // 1. Probe Base Name
                let baseFound = false;
                for (const ext of exts) {
                    const src = `${BASE_HERO_DIR}${targetSeason}/${specialName}${ext}`;
                    const exists = await checkImageExists(src);
                    if (exists) {
                        _specialHeroList.push(src);
                        baseFound = true;
                        // We found one format, we stop checking other formats for SAME base name to avoid duplicates?
                        // Or we allow multiple formats? Usually one format per image.
                        // Let's assume one.
                        break;
                    }
                }

                // 2. If Base Found, Probe Numbered Variants (1..5)
                // If Base NOT found, we skip numbered variants to avoid 404 storms.
                if (baseFound) {
                    for (let i = 1; i <= 5; i++) {
                        let variantFound = false;
                        for (const ext of exts) {
                            const src = `${BASE_HERO_DIR}${targetSeason}/${specialName}${i}${ext}`;
                            const exists = await checkImageExists(src);
                            if (exists) {
                                _specialHeroList.push(src);
                                variantFound = true;
                                break;
                            }
                        }
                        if (!variantFound) break; // Break if "Name1" missing, don't check "Name2"
                    }
                }
            }

            if (_specialHeroList.length > 0) {
                if (changeBg) {
                    _specialHeroIdx =
                        (_specialHeroIdx + 1) % _specialHeroList.length;
                }
                finalUrl = _specialHeroList[_specialHeroIdx];
            }
        } else {
            _currentSpecialName = null;
            _specialHeroList = [];
        }

        // 邏輯 B：普通日子，或該節慶沒圖，使用數字圖庫
        if (!finalUrl && heroList.length > 0) {
            if (changeBg) {
                _heroIdx = (_heroIdx + 1) % heroList.length;
            }
            finalUrl = heroList[_heroIdx];
        }

        if (finalUrl) {
            let transType = "fade"; // 預設使用夢境淡入淡出
            if (changeBg) {
                // 如果是手動點擊（changeBg=true），則使用傳入的 slide 效果，否則保持 fade
                transType = transitionOverride || "fade";
            }
            setHeroBackground(finalUrl, transType);
        }

        // Logic for Center Info Strip (Year/Month/Day) removed to keep it static to Today
    }

    // Initialize Static Header Date (Fixed to 'Today')
    function initHeaderDate() {
        const now = new Date();
        const infoYear = document.getElementById("infoYear");
        const infoMonth = document.getElementById("infoMonth");
        const infoDay = document.getElementById("infoDay");

        if (infoYear) {
            infoYear.innerText = now.getFullYear();
            infoYear.style.fontFamily = "var(--font-serif-num)";
        }
        if (infoMonth) {
            infoMonth.innerText = (now.getMonth() + 1)
                .toString()
                .padStart(2, "0");
            infoMonth.style.fontFamily = "var(--font-serif-num)";
        }
        if (infoDay) {
            infoDay.innerText = now.getDate().toString().padStart(2, "0");
            infoDay.style.fontFamily = "var(--font-serif-num)";
        }
    }

    // Call immediately
    initHeaderDate();

    // Expose functions globally for event handlers if needed, or attach events directly
    // Ideally we use Custom Events for communication
    window.addEventListener("render-hero", (e) => {
        const { date, lunar, changeBg, transitionOverride } = e.detail;
        updateHeroLogic(changeBg, transitionOverride, date, lunar);
    });

    window.addEventListener("slideshow-control", (e) => {
        const { action } = e.detail;
        if (action === "start") startSlideshow();
        if (action === "stop") stopSlideshow();
    });

    // Handle Entry from Welcome Screen via dedicated overlay
    welcomeOverlay.addEventListener("click", (e) => {
        e.stopPropagation();

        // 退出沉浸狀態
        window.dispatchEvent(
            new CustomEvent("welcome-mode", { detail: { active: false } }),
        );

        if (!_isArtworkMode) {
            // 路線 A：非映畫模式 (啟動/歡迎/沉浸) -> 直接喚醒日曆網格
            document.body.classList.remove("initial-welcome");
            window.dispatchEvent(
                new CustomEvent("close-panels", { detail: { showGrid: true } }),
            );
        } else {
            // 路線 B：映畫模式下喚醒 -> 僅恢復映畫介面
            window.dispatchEvent(
                new CustomEvent("close-panels", {
                    detail: { showGrid: false },
                }),
            );
        }
    });

    // Initialize
    const season = getSeason(new Date());
    detectHeroImages(season);

    // Event Listeners for UI
    document.getElementById("btnChangeImage").onclick = () => {
        // 使用者點選「映畫」按鈕，明確進入映畫模式
        window.dispatchEvent(
            new CustomEvent("slideshow-control", {
                detail: { action: "start", isArtwork: true },
            }),
        );

        window.dispatchEvent(
            new CustomEvent("request-hero-change", {
                detail: {
                    changeBg: true,
                    transitionOverride: "slide-from-right",
                },
            }),
        );
        window.dispatchEvent(
            new CustomEvent("close-panels", { detail: { showGrid: false } }),
        );
    };

    function handleDockNavigation(direction) {
        resetIdleTimer();
        const isCalendarActive = document
            .getElementById("btnDay")
            .classList.contains("active");

        if (isCalendarActive) {
            // Calendar Mode: Navigate Months
            window.dispatchEvent(
                new CustomEvent("navigate-month", { detail: direction }),
            );
        } else {
            // Artwork Mode: Navigate Images
            switchHero(direction);
        }
    }

    document.getElementById("btnPrevHero").onclick = () =>
        handleDockNavigation(-1);
    document.getElementById("btnNextHero").onclick = () =>
        handleDockNavigation(1);

    document.getElementById("btnYearMonth").onclick = () => {
        resetIdleTimer();
        window.dispatchEvent(
            new CustomEvent("toggle-panel", { detail: "yearMonth" }),
        );
    };
    document.getElementById("btnDay").onclick = () => {
        resetIdleTimer();
        window.dispatchEvent(new CustomEvent("toggle-grid"));
    };

    window.addEventListener("toggle-grid-view", (e) => {
        const { show } = e.detail;
        const btnYM = document.getElementById("btnYearMonth");
        if (show) {
            heroDockWrapper.classList.remove("hidden");
            document.getElementById("btnDay").classList.add("active");
            document
                .getElementById("btnChangeImage")
                .classList.remove("active");
            btnYM.classList.remove("active");
            btnYM.style.display = "flex";

            // Ensure header and dock are visible
            heroHeader.style.opacity = "1";
            heroDockWrapper.style.opacity = "1";
            heroDockWrapper.style.pointerEvents = "auto";
        } else {
            document.getElementById("btnDay").classList.remove("active");
        }
    });

    window.addEventListener("render-panels", (e) => {
        const { type } = e.detail || {};
        const btnYM = document.getElementById("btnYearMonth");

        if (type === "yearMonth") {
            btnYM.style.display = "flex";
            btnYM.classList.add("active");
            heroHeader.style.opacity = "1";
            heroDockWrapper.style.opacity = "1";
            heroDockWrapper.style.pointerEvents = "auto";
        } else if (type === "today") {
            btnYM.style.display = "none";
            btnYM.classList.remove("active");
            // Hide header and dock for detail view
            heroHeader.style.opacity = "0";
            heroDockWrapper.style.opacity = "0";
            heroDockWrapper.style.pointerEvents = "none";
        }

        document.getElementById("btnDay").classList.remove("active");
        document.getElementById("btnChangeImage").classList.remove("active");
    });

    window.addEventListener("welcome-mode", (e) => {
        const { active } = e.detail;
        if (active) {
            document.body.classList.add("immersion-mode");
            if (window.idleTimer) {
                clearTimeout(window.idleTimer);
                window.idleTimer = null;
            }
            // 路線 A：如果是初始歡迎畫面，激活沉浸後仍需計時隱藏卡片
            if (document.body.classList.contains("initial-welcome")) {
                resetIdleTimer();
            }
        } else {
            document.body.classList.remove("immersion-mode");
            document.body.classList.remove("initial-welcome");

            // 喚醒後，如果仍在映畫模式，不應該「立刻」重啟計時，而是等下一次互動或給予緩衝
            // 避免進入無法退出的死循環。這裡我們不直接調用 resetIdleTimer，而是靠用戶點擊/移動來重置。
        }
    });

    window.addEventListener("hide-panels", () => {
        document.getElementById("btnYearMonth").classList.remove("active");
    });

    window.addEventListener("slideshow-control", (e) => {
        const { action, isArtwork } = e.detail;
        const btnYM = document.getElementById("btnYearMonth");
        const btnMusic = document.getElementById("btnMusic");

        if (action === "start") {
            // 如果 isArtwork 為 true，表示進入「映畫播放器」狀態，需要開啟閒置監控
            // 如果僅是啟動背景輪播 (如啟動畫面)，則不開啟監控
            _isArtworkMode = isArtwork !== false;

            startSlideshow();

            if (_isArtworkMode) {
                document
                    .getElementById("btnChangeImage")
                    .classList.add("active");
                if (btnYM) btnYM.style.display = "none";
                if (btnMusic) btnMusic.style.display = "flex";
                document.getElementById("btnDay").classList.remove("active");
                if (btnYM) btnYM.classList.remove("active");
                resetIdleTimer();
            }
        }
        if (action === "stop") {
            _isArtworkMode = false;
            stopSlideshow();
            if (idleTimer) clearTimeout(idleTimer);
            document
                .getElementById("btnChangeImage")
                .classList.remove("active");
            if (btnYM) btnYM.style.display = "flex";
            if (btnMusic) btnMusic.style.display = "none";
        }
    });

    // PWA Install
    let deferredPrompt;
    const installBtn = document.getElementById("installBtn");
    window.addEventListener("beforeinstallprompt", (e) => {
        e.preventDefault();
        deferredPrompt = e;
        if (installBtn) installBtn.style.display = "block";
    });
    if (installBtn) {
        installBtn.addEventListener("click", async () => {
            if (deferredPrompt) {
                await deferredPrompt.prompt();
                deferredPrompt = null;
                installBtn.style.display = "none";
            }
        });
    }

    // Music Control
    const btnMusic = document.getElementById("btnMusic");
    const bgMusic = document.getElementById("bgMusic");
    const zenPlaylist = [
        (baseDir + "assets/audio/ambient.mp3").replace(/\/+/g, "/"),
        (baseDir + "assets/audio/danyvin.mp3").replace(/\/+/g, "/"),
        (baseDir + "assets/audio/danyvin-journey.mp3").replace(/\/+/g, "/"),
    ];
    window._zenTrackIdx = Math.floor(Math.random() * zenPlaylist.length);

    if (btnMusic && bgMusic) {
        // 音樂守護：當一首結束，自動接下一首
        bgMusic.onended = () => {
            window._zenTrackIdx =
                (window._zenTrackIdx + 1) % zenPlaylist.length;
            bgMusic.src = zenPlaylist[window._zenTrackIdx];
            bgMusic.play();
        };

        btnMusic.onclick = () => {
            if (bgMusic.paused) {
                // 如果是空的，初始化第一首
                if (!bgMusic.src || bgMusic.src === "" || bgMusic.ended) {
                    bgMusic.src = zenPlaylist[window._zenTrackIdx];
                }

                bgMusic
                    .play()
                    .then(() => {
                        console.log(
                            "[ZenMusic] Flowing:",
                            zenPlaylist[window._zenTrackIdx],
                        );
                    })
                    .catch((e) => {
                        console.log("[ZenMusic] Blocked:", e);
                    });
                btnMusic.classList.add("playing");
            } else {
                bgMusic.pause();
                btnMusic.classList.remove("playing");
                // 巧妙設計：暫停即預備下一首，再次點擊就會換歌
                window._zenTrackIdx =
                    (window._zenTrackIdx + 1) % zenPlaylist.length;
                bgMusic.src = zenPlaylist[window._zenTrackIdx];
            }
        };
    }

    // 啟動時先跑一次閒置計時，確保歡迎畫面 10 秒後會自動進入沉浸
    resetIdleTimer();
</script>
