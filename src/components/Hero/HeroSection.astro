---
import HeroBackground from "./HeroBackground.astro";
import HeroDock from "./HeroDock.astro";
import HeroHeader from "./HeroHeader.astro";
import MusicPlayer from "./MusicPlayer.astro";
import NotePad from "./NotePad.astro";
import WelcomeOverlay from "./WelcomeOverlay.astro";
---

<HeroBackground />
<WelcomeOverlay />
<HeroHeader />
<HeroDock />
<MusicPlayer />
<NotePad />

<!-- Zen Mode Gesture Hint -->
<div id="zenGestureHint" class="zen-gesture-hint">
    <div class="hint-icon">👆</div>
    <div class="hint-text">左右滑動切換背景</div>
</div>

<!-- Toast Notification Container -->
<div id="toastContainer" class="toast-container"></div>

<script src="../../scripts/hero/hero-main.ts"></script>
