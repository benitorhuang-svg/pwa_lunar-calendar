---
import "../../styles/hero/notepad.css";
---

<!-- Note Pad Overlay -->
<div class="note-pad-overlay" id="notePadOverlay">
    <div class="note-container">
        <!-- Header: Controls -->
        <div class="note-header">
            <div class="note-controls-left">
                <button class="note-btn close-btn" id="btnNoteClose" title="關閉">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg
                    >
                </button>
                <div class="font-selector">
                    <select id="noteFontSelect">
                        <option value="font-serif">襯線體 (Serif)</option>
                        <option value="font-sans">黑體 (Sans)</option>
                        <option value="font-calligraphy">書法體 (Calligraphy)</option>
                        <option value="font-hand">手寫體 (Handwriting)</option>
                    </select>
                </div>
            </div>

            <div class="note-controls-right">
                <input type="date" id="noteDatePicker" class="note-date-picker" />
                <button class="note-btn action-btn" id="btnNoteSave">儲存 (Save)</button>
                <button class="note-btn action-btn secondary" id="btnNoteExport"
                    >匯出 (Export)</button
                >
            </div>
        </div>

        <!-- Editor Area -->
        <div class="note-editor-wrapper">
            <textarea
                id="noteEditor"
                class="note-textarea font-serif"
                placeholder="在此寫下您的隨筆..."></textarea>
        </div>
    </div>
</div>
