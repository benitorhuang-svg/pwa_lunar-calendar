---
import "../../styles/hero/notepad.css";
---

<!-- Note Pad Overlay: Plant Paper / Glassine Design -->
<div class="note-pad-overlay" id="notePadOverlay">
    <div class="note-container glass-morphic">
        <div class="glass-reflection"></div>

        <div class="note-content-area">
            <!-- Header: Date & Font Selection -->
            <div class="note-header-zen">
                <div class="note-date-display">
                    <input
                        aria-label="選擇日期"
                        class="note-date-picker-zen"
                        id="noteDatePicker"
                        type="date"
                    />
                    <span class="date-sep">/</span>
                    <div class="font-selector-zen">
                        <select aria-label="切換字體" id="noteFontSelect">
                            <option value="font-serif">雅致襯線 (Serif)</option>
                            <option value="font-sans">極簡黑體 (Sans)</option>
                            <option value="font-calligraphy">行雲流水 (Calligraphy)</option>
                            <option value="font-hand">手感筆觸 (Hand)</option>
                        </select>
                    </div>
                </div>

                <div class="header-tools-right">
                    <button class="note-close-trigger" id="btnNoteClose" title="關閉隨筆">
                        <svg
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            viewBox="0 0 24 24"
                        >
                            <path d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Editor: The Sacred Space -->
            <div class="note-editor-canvas">
                <textarea
                    class="note-textarea-zen font-serif"
                    id="noteEditor"
                    placeholder="在此刻，記下內心的溫度..."
                    spellcheck="false"></textarea>
            </div>

            <!-- Footer: Actions -->
            <div class="note-footer-zen">
                <div class="note-status-indicator" id="noteStatus">拾起筆尖，紀錄當下</div>
                <div class="note-actions-group">
                    <button class="note-action-pill secondary" id="btnNoteExport">
                        匯出隨筆
                    </button>
                    <button class="note-action-pill primary" id="btnNoteSave"> 留存記憶 </button>
                </div>
            </div>
        </div>
    </div>
</div>
