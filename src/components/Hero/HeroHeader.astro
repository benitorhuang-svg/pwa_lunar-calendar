---
import "../../styles/hero/header.css";
---

<!-- Dynamic Header: Only the Info Strip remains for a clean magazine look -->
<header class="hero-header">
    <button class="hero-info-strip" id="heroInfoStrip" title="回到今日" aria-label="回到今日">
        <div class="today-date-row">
            <span id="infoYear"></span><span class="label">年</span>
            <span class="info-sep">|</span>
            <span id="infoMonth"></span><span class="label">月</span>
            <span class="info-sep">/</span>
            <span id="infoDay"></span><span class="label">日</span>
        </div>
        <div class="today-action-row">回到今日</div>
        <span class="underline-indicator"></span>
    </button>

    <!-- Slideshow Settings (Top-left) -->
    <div class="slideshow-settings">
        <button
            aria-label="幻燈片秒數設定"
            class="slideshow-settings-btn"
            id="btnSlideshowSettings"
            title="圖片更換秒數"
        >
            <span class="current-setting-label" id="slideshowCurrentVal">3s</span>
            <!-- stopwatch icon for interval -->
            <svg
                fill="none"
                height="16"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="16"
            >
                <circle cx="12" cy="14" r="8"></circle>
                <path d="M12 10v4l2 2"></path>
                <path d="M12 2v4"></path>
                <path d="M10 2h4"></path>
            </svg>
        </button>

        <div aria-hidden="true" class="slideshow-settings-menu" id="slideshowSettingsMenu">
            <button class="menu-item" data-val="black">全黑模式</button>
            <button class="menu-item" data-val="1000">1s</button>
            <button class="menu-item" data-val="3000">3s</button>
            <button class="menu-item" data-val="5000">5s</button>
            <button class="menu-item" data-val="custom">自訂</button>
        </div>
    </div>
</header>
