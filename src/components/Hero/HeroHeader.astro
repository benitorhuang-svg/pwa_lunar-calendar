---
import "../../styles/hero/header.css";
---

<!-- Dynamic Header: Only the Info Strip remains for a clean magazine look -->
<header class="hero-header">
    <div class="hero-info-strip" id="heroInfoStrip">
        <span id="infoYear"></span><span class="label">年</span>
        <span class="info-dot">·</span>
        <span id="infoMonth"></span><span class="label">月</span>
        <span class="info-dot">·</span>
        <span id="infoDay"></span><span class="label">日</span>
    </div>
</header>
