---
import "../../styles/hero/header.css";
---

<!-- Dynamic Header: Only the Info Strip remains for a clean magazine look -->
<header class="hero-header">
    <div class="hero-info-strip" id="heroInfoStrip">
        <span id="infoYear"></span><span class="label">年</span>
        <span class="info-dot">·</span>
        <span id="infoMonth"></span><span class="label">月</span>
        <span class="info-dot">·</span>
        <span id="infoDay"></span><span class="label">日</span>
    </div>

    <!-- Foolproof View Toggle Button (Calendar <-> Immersion) -->
    <button class="hero-calendar-btn" id="btnHeaderToggle" title="切換視圖" aria-label="切換視圖">
        <svg
            id="iconCalendar"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <svg
            id="iconImmersion"
            class="hidden-icon"
            width="20"
            height="20"
            style="display:none;"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
    </button>
</header>
