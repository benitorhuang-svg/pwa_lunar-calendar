<div id="heroBgContainer"></div>

<style is:global>
    #heroBgContainer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        overflow: hidden;
        /* background: #000; Removed to avoid black flash */
    }

    .hero-bg-item {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        transition:
            opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1),
            transform 1.5s cubic-bezier(0.4, 0, 0.2, 1),
            filter 1.2s ease;
    }

    /* Transition states */
    .is-new {
        opacity: 0;
        transform: scale(1.1);
        filter: blur(10px);
    }
    .is-next {
        opacity: 0;
        transform: translateX(30px) scale(1.05);
        filter: blur(5px);
    }
    .is-prev {
        opacity: 0;
        transform: translateX(-30px) scale(1.05);
        filter: blur(5px);
    }
    .blur-out {
        opacity: 0;
        filter: blur(20px);
    }
</style>
