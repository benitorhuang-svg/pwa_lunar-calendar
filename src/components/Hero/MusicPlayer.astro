---
import "../../styles/hero/music-player.css";
---

<!-- Music Player & Utility Controls -->
<div class="music-control-wrapper">
    <!-- 1. Music Toggle (Rightmost in display) -->
    <button
        aria-label="播放背景音樂"
        class="music-toggle-btn"
        id="btnMusic"
        title="播放音樂"
        type="button"
    >
        <svg
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
            ><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle
                cx="18"
                cy="16"
                r="3"></circle>
            <line class="mute-line" x1="1" x2="23" y1="23" y2="1"></line>
        </svg>
    </button>

    <!-- 2. Immersion Mode Toggle (Middle in display) -->
    <button
        aria-label="切換沉浸模式"
        class="immersion-toggle-btn"
        id="btnImmersion"
        title="沉浸模式"
        type="button"
    >
        <!-- Icon 1: Focus/Frame-style (Show when in Calendar view) -->
        <svg
            class="icon-immersion"
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
        >
            <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
            <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
            <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
            <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
            <circle cx="12" cy="12" r="1.5"></circle>
        </svg>

        <!-- Icon 2: Calendar-style (Show when in Immersion view) -->
        <svg
            class="icon-calendar"
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
        >
            <rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
        </svg>
    </button>

    <!-- 3. Pen Toggle (Leftmost in display) -->
    <button aria-label="隨筆記錄" class="pen-toggle-btn" id="btnPen" title="隨筆記錄" type="button">
        <svg
            fill="none"
            height="18"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="18"
            ><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path><line
                x1="16"
                x2="2"
                y1="8"
                y2="22"></line><line x1="17.5" x2="9" y1="15" y2="15"></line></svg
        >
    </button>

    <audio id="bgMusic" loop preload="none">
        <source src={import.meta.env.BASE_URL + "assets/audio/ambient.mp3"} type="audio/mpeg" />
    </audio>
</div>
