---
import "../../styles/hero/music-player.css";
import "../../styles/hero/gallery-submenu.css";
import HeroGallerySubmenu from "./HeroGallerySubmenu.astro";

/**
 * Music Player & Utility Controls
 * Consolidated vertical dock for all system utilities
 *
 * Order:
 * 1. FAQ
 * 2. Calendar / Artwork Toggle
 * 3. Music Player
 * 4. Diary / Note
 * 5. Source Settings (Gallery) - 資料來源設定
 */
const defaultAudio = import.meta.env.BASE_URL + "assets/audio/ambient.mp3";
---

<div class="music-control-wrapper">
    <!-- 1. FAQ (First) -->
    <button
        aria-label="常見問題"
        class="utility-btn faq-toggle-btn"
        id="btnFaq"
        title="說明"
        type="button"
    >
        <svg
            fill="none"
            height="20"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="20"
        >
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" x2="12.01" y1="17" y2="17"></line>
        </svg>
    </button>

    <!-- 2. Calendar / Artwork Toggle -->
    <div class="mode-toggles-group">
        <button
            aria-label="日曆/映畫模式"
            class="utility-btn mode-btn-calendar"
            id="btnDay"
            title="切換模式"
            type="button"
        >
            <svg
                class="icon-artwork"
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"
            >
                <rect height="18" rx="2" ry="2" width="18" x="3" y="3"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <svg
                class="icon-calendar"
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"
            >
                <rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect>
                <line x1="16" x2="16" y1="2" y2="6"></line>
                <line x1="8" x2="8" y1="2" y2="6"></line>
                <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
        </button>
    </div>

    <!-- 3. Music Control -->
    <button
        aria-label="背景音樂"
        class="utility-btn music-toggle-btn"
        id="btnMusic"
        title="音樂開關"
        type="button"
    >
        <svg
            fill="none"
            height="20"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="20"
        >
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
            <line class="mute-line" x1="1" x2="23" y1="23" y2="1"></line>
        </svg>
    </button>

    <!-- 4. Diary / Note -->
    <button id="btnNote" class="utility-btn note-btn" title="記事本" type="button">
        <svg
            fill="none"
            height="20"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="20"
        >
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
    </button>

    <!-- 5. Settings (Source Setup) -->
    <div class="gallery-control-wrapper" id="galleryControlWrapper">
        <button
            aria-label="系統設置"
            class="utility-btn settings-btn"
            id="btnGalleryMenu"
            title="背景與音樂設置"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"
            >
                <path d="M12 20v-6M9 20v-10M15 20v-2M18 20v-8M21 20V4M6 20v-4M3 20v-2"></path>
            </svg>
        </button>
        <HeroGallerySubmenu defaultAudio={defaultAudio} />
    </div>

    <audio id="bgMusic" loop preload="none">
        <source src={import.meta.env.BASE_URL + "assets/audio/ambient.mp3"} type="audio/mpeg" />
    </audio>
</div>
