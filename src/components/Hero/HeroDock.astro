---

---

<!-- Unified Floating Dock: Centered at the bottom -->
<div class="hero-dock-wrapper">
    <div class="hero-dock" id="heroDock">
        <button
            class="dock-item prev group-image"
            id="btnPrevHero"
            title="上一張"
        >
            <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="15 18 9 12 15 6"></polyline></svg
            >
        </button>
        <div class="dock-divider"></div>
        <button class="dock-item main-btn group-image" id="btnChangeImage">
            <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                ></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline
                    points="21 15 16 10 5 21"></polyline></svg
            >
            <span>映畫</span>
        </button>
        <!-- 音樂圖標移到映畫右側 -->
        <button class="dock-item music-btn" id="btnMusic" title="播放音樂">
            <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"
                ></circle><circle cx="18" cy="16" r="3"></circle></svg
            >
        </button>
        <button class="dock-item main-btn group-calendar" id="btnYearMonth">
            <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                    points="12 6 12 12 16 14"></polyline></svg
            >
            <span class="ym-text">年月</span>
        </button>
        <button class="dock-item main-btn group-calendar" id="btnDay">
            <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                    x1="8"
                    y1="2"
                    x2="8"
                    y2="6"></line><line x1="3" y1="10" x2="21" y2="10"
                ></line></svg
            >
            <span>日曆</span>
        </button>
        <div class="dock-divider"></div>
        <button
            class="dock-item next group-image"
            id="btnNextHero"
            title="下一張"
        >
            <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="9 18 15 12 9 6"></polyline></svg
            >
        </button>
    </div>
</div>
