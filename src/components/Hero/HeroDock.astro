---
const baseUrl = import.meta.env.BASE_URL;
const defaultAudio = `${baseUrl}/assets/audio/ambient.mp3`.replace(/\/+/g, "/");
---

<!-- Unified Floating Dock: Centered at the bottom -->
<div class="hero-dock-wrapper">
    <div class="hero-dock" id="heroDock">
        <button
            aria-label="上一張圖片"
            class="dock-item prev group-calendar"
            id="btnPrevHero"
            title="上一張"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"><polyline points="15 18 9 12 15 6"></polyline></svg
            >
        </button>

        <!-- 1. 映畫按鈕 (Artwork Toggle) -->
        <button
            aria-label="切換映畫模式"
            class="dock-item main-btn group-image"
            id="btnChangeImage"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"
                ><rect height="18" rx="2" ry="2" width="18" x="3" y="3"></rect><circle
                    cx="8.5"
                    cy="8.5"
                    r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg
            >
            <span>映畫</span>
        </button>

        <div class="dock-divider"></div>

        <!-- 2. 中間動態按鈕：年月 或 藝廊 (Middle Dynamic Button) -->
        <div class="middle-control-slot">
            <!-- 年月按鈕 (預設顯示) -->
            <button
                aria-label="選擇年/月"
                class="dock-item main-btn group-calendar"
                id="btnYearMonth"
                type="button"
            >
                <svg
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="24"
                    ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
                    ></polyline></svg
                >
            </button>

            <!-- 藝廊管理 (僅在映畫模式顯示) -->
            <div class="gallery-control-wrapper" id="galleryControlWrapper" style="display: none;">
                <button
                    aria-label="藝廊設置"
                    class="dock-item gallery-btn group-image"
                    id="btnGalleryMenu"
                    title="藝廊設置"
                    type="button"
                >
                    <svg
                        fill="none"
                        height="20"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="20"
                        ><path d="M12 20v-6M9 20v-10M15 20v-2M18 20v-8M21 20V4M6 20v-4M3 20v-2"
                        ></path></svg
                    >
                </button>
                <div class="gallery-submenu" id="gallerySubmenu">
                    <div class="submenu-main-container">
                        <!-- Left: Image Management Side -->
                        <div class="submenu-column image-column">
                            <button
                                class="submenu-item active"
                                data-mode="default"
                                id="btnGalleryDefault"
                            >
                                <svg
                                    fill="none"
                                    height="14"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                    width="14"
                                    ><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                                    ></path><polyline points="9 22 9 12 15 12 15 22"
                                    ></polyline></svg
                                >
                                <span>預設圖片</span>
                            </button>
                            <button class="submenu-item" data-mode="custom" id="btnGalleryCustom">
                                <svg
                                    fill="none"
                                    height="14"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                    width="14"
                                    ><rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                                    ></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline
                                        points="21 15 16 10 5 21"></polyline></svg
                                >
                                <span>自選圖片</span>
                            </button>
                            <button class="submenu-item" data-mode="hybrid" id="btnGalleryHybrid">
                                <svg
                                    fill="none"
                                    height="14"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                    width="14"
                                    ><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path
                                        d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"
                                    ></path></svg
                                >
                                <span>混合圖片輪播</span>
                            </button>

                            <div class="column-divider"></div>

                            <button class="submenu-item" id="btnGalleryFitToggle">
                                <svg
                                    fill="none"
                                    height="14"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                    width="14"
                                    ><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg
                                >
                                <span id="textGalleryFit">顯示完整圖片</span>
                            </button>

                            <div class="column-divider"></div>

                            <button
                                class="submenu-item add-btn"
                                id="btnGalleryAdd"
                                title="新增圖片"
                            >
                                <svg
                                    fill="none"
                                    height="14"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                    width="14"
                                    ><line x1="12" x2="12" y1="5" y2="19"></line><line
                                        x1="5"
                                        x2="19"
                                        y1="12"
                                        y2="12"></line></svg
                                >
                                <span>新增圖片</span>
                            </button>
                            <button
                                class="submenu-item add-btn"
                                id="btnGalleryAddFolder"
                                title="匯入圖片資料夾"
                            >
                                <svg
                                    fill="none"
                                    height="14"
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                    width="14"
                                    ><path
                                        d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
                                    ></path></svg
                                >
                                <span>匯入圖片資料夾</span>
                            </button>
                        </div>

                        <!-- Vertical Divider in the middle -->
                        <div class="vertical-column-divider"></div>

                        <!-- Right: Music Navigation Side -->
                        <div class="submenu-column music-column">
                            <div class="radio-section">
                                <button class="radio-item" data-url={defaultAudio}
                                    >預設背景音樂 (Default Ambient)</button
                                >
                                <div class="radio-header">
                                    <svg
                                        fill="none"
                                        height="14"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        viewBox="0 0 24 24"
                                        width="14"
                                        ><circle cx="12" cy="12" r="2"></circle><path
                                            d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.15 0a10 10 0 0 1 0-14.14"
                                        ></path></svg
                                    >
                                    <span>線上療癒音樂</span>
                                </div>
                                <div class="radio-presets">
                                    <div class="radio-row">
                                        <button
                                            class="radio-item"
                                            data-url="http://ice1.somafm.com/thistle-128-mp3"
                                            >薊絨音樂 (thistle)</button
                                        >
                                        <button class="radio-delete-btn" aria-label="刪除此電台"
                                            >✕</button
                                        >
                                    </div>
                                    <div class="radio-row">
                                        <button
                                            class="radio-item"
                                            data-url="http://vprclassical.streamguys.net/vprclassical128.mp3"
                                            >古典音樂 (Classical)</button
                                        >
                                        <button class="radio-delete-btn" aria-label="刪除此電台"
                                            >✕</button
                                        >
                                    </div>
                                    <div class="radio-row">
                                        <button
                                            class="radio-item"
                                            data-url="https://stream.rcs.revma.com/ndk05tyy2tzuv"
                                            >中廣音樂網 (BCC Music)</button
                                        >
                                        <button class="radio-delete-btn" aria-label="刪除此電台"
                                            >✕</button
                                        >
                                    </div>
                                    <div class="radio-row">
                                        <button class="radio-item" id="btnMusicUrl"
                                            >自訂電台網址...</button
                                        >
                                        <!-- Custom URL button doesn't need delete here, as it's an action to add -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="submenu-footer">
                        <button
                            class="submenu-item"
                            id="btnGalleryClear"
                            style="color: rgba(255, 100, 100, 0.75);"
                        >
                            <svg
                                fill="none"
                                height="14"
                                stroke="currentColor"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                                width="14"
                                ><path d="M3 6h18"></path><path
                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                                ></path><line x1="10" y1="11" x2="10" y2="17"></line><line
                                    x1="14"
                                    y1="11"
                                    x2="14"
                                    y2="17"></line></svg
                            >
                            <span>清空自定媒體</span>
                        </button>
                    </div>
                </div>

                <input
                    accept="image/*"
                    id="galleryInput"
                    multiple
                    style="display: none;"
                    type="file"
                />
                <input
                    accept="image/*"
                    id="folderInput"
                    {...{ webkitdirectory: "", directory: "" }}
                    multiple
                    style="display: none;"
                    type="file"
                />
            </div>
        </div>

        <div class="dock-divider"></div>

        <!-- 3. 日曆按鈕 (Calendar Toggle) -->
        <button
            aria-label="切換日曆檢視"
            class="dock-item main-btn group-calendar"
            id="btnDay"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"
                ><rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect><line
                    x1="16"
                    x2="16"
                    y1="2"
                    y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line
                    x1="3"
                    x2="21"
                    y1="10"
                    y2="10"></line></svg
            >
            <span>日曆</span>
        </button>

        <button
            aria-label="下一張圖片"
            class="dock-item next group-calendar"
            id="btnNextHero"
            title="下一張"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"><polyline points="9 18 15 12 9 6"></polyline></svg
            >
        </button>

        <style is:global>
            .gallery-control-wrapper {
                position: relative;
                display: flex;
                align-items: center;
            }

            .gallery-submenu {
                position: absolute;
                bottom: 60px;
                left: 50%;
                transform: translateX(-50%) translateY(10px);
                background: rgba(15, 15, 20, 0.9); /* 更深沉的底色 */
                backdrop-filter: blur(25px) saturate(150%);
                -webkit-backdrop-filter: blur(25px) saturate(150%);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-top: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 20px;
                display: flex;
                flex-direction: column;
                min-width: 420px;
                padding: 0;
                overflow: hidden;
                opacity: 0;
                visibility: hidden;
                transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
                box-shadow:
                    0 15px 45px rgba(0, 0, 0, 0.6),
                    0 0 20px rgba(255, 255, 255, 0.05);
                pointer-events: auto;
                z-index: 2200;
            }

            .gallery-submenu.show {
                opacity: 1;
                visibility: visible;
                transform: translateX(-50%) translateY(0);
            }

            .submenu-item {
                background: transparent;
                border: none;
                color: rgba(255, 255, 255, 0.65);
                padding: 10px 16px;
                border-radius: 12px;
                font-size: 0.88rem;
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
                transition: all 0.3s ease;
                white-space: nowrap;
                text-align: left;
                font-family: var(--font-serif);
                letter-spacing: 0.05em;
            }

            .submenu-item:hover {
                background: rgba(255, 255, 255, 0.1);
                color: #fff;
                transform: translateX(4px);
            }

            .submenu-section-label {
                font-size: 0.6rem;
                color: rgba(255, 255, 255, 0.25);
                padding: 12px 16px 4px;
                letter-spacing: 0.25em;
                font-weight: 400;
                text-transform: uppercase;
                font-family: var(--font-serif);
                font-style: italic;
            }

            .submenu-item.active {
                background: rgba(255, 255, 255, 0.12);
                color: #fff;
                font-weight: 600;
                text-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
                box-shadow: inset 0 0 12px rgba(255, 255, 255, 0.03);
            }

            .submenu-divider {
                height: 1px;
                background: linear-gradient(
                    to right,
                    transparent,
                    rgba(255, 255, 255, 0.08),
                    transparent
                );
                margin: 6px 12px;
            }

            .submenu-item.add-btn {
                color: rgba(255, 255, 255, 0.75);
            }

            .submenu-item.add-btn:hover {
                background: rgba(255, 255, 255, 0.12);
                color: #fff;
            }

            /* Radio Section Styling */
            .radio-section {
                padding: 4px 12px;
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .radio-header {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 0.7rem;
                color: rgba(255, 255, 255, 0.4);
                padding-left: 4px;
                letter-spacing: 0.05em;
            }

            .radio-presets {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .radio-item {
                background: rgba(255, 255, 255, 0.03);
                border: none;
                color: rgba(255, 255, 255, 0.6);
                padding: 8px 12px;
                border-radius: 8px;
                font-size: 0.8rem;
                text-align: left;
                cursor: pointer;
                transition: all 0.2s ease;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                font-family: var(--font-serif);
                flex: 1; /* Take remaining space */
            }

            .radio-row {
                display: flex;
                align-items: center;
                gap: 4px;
                width: 100%;
            }

            .radio-delete-btn {
                background: transparent;
                border: none;
                color: rgba(255, 100, 100, 0.6);
                cursor: pointer;
                padding: 4px 8px;
                font-size: 0.8rem;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 4px;
                transition: all 0.2s ease;
            }

            .radio-delete-btn:hover {
                background: rgba(255, 100, 100, 0.1);
                color: rgba(255, 100, 100, 1);
            }

            .radio-item:hover {
                background: rgba(255, 255, 255, 0.1);
                color: #fff;
                transform: translateX(4px);
            }

            .radio-item.active {
                background: rgba(212, 175, 55, 0.2); /* Gold tint */
                color: #fff;
                font-weight: 600;
                box-shadow: inset 0 0 10px rgba(212, 175, 55, 0.1);
                border-left: 2px solid rgba(212, 175, 55, 0.8);
                padding-left: 10px; /* Adjust for border */
            }

            /* Split Layout Styling */
            .submenu-main-container {
                display: flex;
                flex-direction: row;
                width: 100%;
            }

            .submenu-column {
                flex: 1;
                padding: 12px 8px;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .image-column {
                background: rgba(255, 255, 255, 0.02);
            }

            .music-column {
                background: rgba(0, 0, 0, 0.15);
            }

            .vertical-column-divider {
                width: 1px;
                background: linear-gradient(
                    to bottom,
                    transparent,
                    rgba(255, 255, 255, 0.06),
                    transparent
                );
            }

            .column-divider {
                height: 1px;
                background: rgba(255, 255, 255, 0.04);
                margin: 4px 12px;
            }

            .submenu-footer {
                padding: 8px;
                background: rgba(0, 0, 0, 0.2);
                border-top: 1px solid rgba(255, 255, 255, 0.04);
            }
        </style>
    </div>
</div>
