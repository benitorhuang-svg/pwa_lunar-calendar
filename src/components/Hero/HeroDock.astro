---
/**
 * Hero Dock Component
 * Main navigation and control center for the Hero section
 */
import HeroGallerySubmenu from "./HeroGallerySubmenu.astro";
import "../../styles/hero/dock.css";

const baseUrl = import.meta.env.BASE_URL;
const defaultAudio = `${baseUrl}/assets/audio/ambient.mp3`.replace(/\/+/g, "/");
---

<!-- Unified Floating Dock: Centered at the bottom -->
<div class="hero-dock-wrapper">
    <div class="hero-dock" id="heroDock">
        <!-- 1. Navigation: Previous -->
        <button
            aria-label="上一張圖片"
            class="dock-item prev"
            id="btnPrevHero"
            title="上一張"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"><polyline points="15 18 9 12 15 6"></polyline></svg
            >
        </button>

        <div class="dock-divider"></div>

        <!-- 2. Main Controls: Artwork Toggle, Date/Gallery, and Calendar Toggle -->
        <!-- These are grouped together as the core "Center Trio" -->

        <!-- 映畫按鈕 (Artwork Toggle) -->
        <button
            aria-label="切換映畫模式"
            class="dock-item main-btn"
            id="btnChangeImage"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"
                ><rect height="18" rx="2" ry="2" width="18" x="3" y="3"></rect><circle
                    cx="8.5"
                    cy="8.5"
                    r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg
            >
            <span>映畫</span>
        </button>

        <!-- 中間動態按鈕：年月 或 藝廊 (Middle Dynamic Slot) -->
        <div class="middle-control-slot">
            <!-- 年月按鈕 (圖示 - Clock Icon) -->
            <button
                aria-label="選擇年/月"
                class="dock-item main-btn group-calendar"
                id="btnYearMonth"
                type="button"
            >
                <svg
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    width="24"
                    ><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"
                    ></polyline></svg
                >
            </button>

            <!-- 藝廊管理 (僅在映畫模式顯示) -->
            <div class="gallery-control-wrapper group-image" id="galleryControlWrapper">
                <button
                    aria-label="藝廊設置"
                    class="dock-item gallery-btn"
                    id="btnGalleryMenu"
                    title="藝廊設置"
                    type="button"
                >
                    <svg
                        fill="none"
                        height="20"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                        width="20"
                        ><path d="M12 20v-6M9 20v-10M15 20v-2M18 20v-8M21 20V4M6 20v-4M3 20v-2"
                        ></path></svg
                    >
                </button>

                <HeroGallerySubmenu defaultAudio={defaultAudio} />
            </div>
        </div>

        <!-- 日曆按鈕 (Calendar Toggle) -->
        <button aria-label="切換日曆檢視" class="dock-item main-btn" id="btnDay" type="button">
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"
                ><rect height="18" rx="2" ry="2" width="18" x="3" y="4"></rect><line
                    x1="16"
                    x2="16"
                    y1="2"
                    y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line
                    x1="3"
                    x2="21"
                    y1="10"
                    y2="10"></line></svg
            >
            <span>日曆</span>
        </button>

        <div class="dock-divider"></div>

        <!-- 3. Navigation: Next -->
        <button
            aria-label="下一張圖片"
            class="dock-item next"
            id="btnNextHero"
            title="下一張"
            type="button"
        >
            <svg
                fill="none"
                height="20"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                width="20"><polyline points="9 18 15 12 9 6"></polyline></svg
            >
        </button>
    </div>
</div>
