---
import "../styles/global.css";
import { pwaInfo } from "virtual:pwa-info";
---

<!doctype html>
<html lang="zh-TW">
    <head>
        <meta charset="UTF-8" />
        <meta
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
            name="viewport"
        />
        <meta content="#1A1A2E" name="theme-color" />
        <meta content="yes" name="apple-mobile-web-app-capable" />
        <meta content="black-translucent" name="apple-mobile-web-app-status-bar-style" />
        <title>農民曆 PWA</title>
        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
        <link
            href={`${import.meta.env.BASE_URL}/assets/icons/icon-192.png`.replace(/\/+/g, "/")}
            rel="icon"
        />
        <link
            href={`${import.meta.env.BASE_URL}/assets/icons/icon-192.png`.replace(/\/+/g, "/")}
            rel="apple-touch-icon"
        />

        <!-- SEO / Open Graph -->
        <meta
            name="description"
            content="傳統智慧・現代應用 - 數位農民曆 PWA。查詢每日宜忌、節氣流轉與月相盈虧。"
        />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="農民曆 PWA - 數位與傳統的完美結合" />
        <meta
            property="og:description"
            content="查詢每日宜忌、節氣流轉與月相盈虧。體驗如宣紙般的溫潤質感與現代科技的便利。"
        />
        <meta
            property="og:image"
            content={`${import.meta.env.BASE_URL}/assets/icons/icon-512.png`.replace(/\/+/g, "/")}
        />
        <meta property="og:site_name" content="農民曆 PWA" />

        <!-- Core Logic Libraries (Synchronous Load) -->

        <link href="https://fonts.googleapis.com" rel="preconnect" />
        <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />

        <!-- Preload Google Fonts CSS for faster font loading on mobile -->
        <link
            rel="preload"
            as="style"
            href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Zhi+Mang+Xing&family=Ma+Shan+Zheng&display=block"
        />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Zhi+Mang+Xing&family=Ma+Shan+Zheng&display=block"
            rel="stylesheet"
        />
        <slot name="head" />
    </head>
    <body class="theme-autumn">
        <slot />
    </body>
</html>

<script src="../scripts/layout/layout-main.ts"></script>
