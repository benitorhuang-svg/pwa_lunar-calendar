---
import "../styles/global.css";
import { pwaInfo } from "virtual:pwa-info";
---

<!doctype html>
<html lang="zh-TW">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
        />
        <meta name="theme-color" content="#C41E3A" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
        />
        <title>農民曆 PWA</title>
        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
        <link
            rel="icon"
            href={`${import.meta.env.BASE_URL}/assets/icons/icon-192.png`.replace(
                /\/+/g,
                "/",
            )}
        />
        <link
            rel="apple-touch-icon"
            href={`${import.meta.env.BASE_URL}/assets/icons/icon-192.png`.replace(
                /\/+/g,
                "/",
            )}
        />

        <!-- Core Logic Libraries (Synchronous Load) -->
        <script
            is:inline
            src={`${import.meta.env.BASE_URL}/assets/js/lunar-core.js`.replace(
                /\/+/g,
                "/",
            )}></script>
        <script
            is:inline
            src={`${import.meta.env.BASE_URL}/assets/gallery/manifest.js`.replace(
                /\/+/g,
                "/",
            )}></script>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Zhi+Mang+Xing&display=swap"
            rel="stylesheet"
        />
        <script
            is:inline
            set:html={`
                let base = "${import.meta.env.BASE_URL}";
                if (!base.endsWith('/')) base += '/';
                window.APP_BASE_URL = base;
            `}
        />
        <slot name="head" />
    </head>
    <body class="theme-autumn">
        <slot />
    </body>
</html>

<script src="../scripts/layout/layout-main.js"></script>

