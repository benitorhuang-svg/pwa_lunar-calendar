---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/Hero/HeroSection.astro";
import CalendarBoard from "../components/Calendar/CalendarBoard.astro";
import FloatingPanels from "../components/Panels/FloatingPanels.astro";
---

<Layout>
    <Fragment slot="head">
        <!-- Core Logic Libraries -->
        <script
            is:inline
            src={import.meta.env.BASE_URL + "assets/js/lunar-core.js"}></script>
        <script
            is:inline
            src={import.meta.env.BASE_URL + "assets/gallery/manifest.js"}
        ></script>
    </Fragment>

    <div class="app-container" id="appContainer">
        <!-- Components -->
        <HeroSection />
        <FloatingPanels />
        <CalendarBoard />
    </div>

    <script is:inline>
        // State Management
        let selectedYear = new Date().getFullYear();
        let selectedMonth = new Date().getMonth();
        let selectedDay = new Date().getDate();
        const today = new Date();
        let activePanel = null;

        // --- Core Functions ---

        function updateState() {
            const date = new Date(selectedYear, selectedMonth, selectedDay);
            const lunar = Lunar.fromDate(date);
            const festival = lunar.getFestival();
            const lunarMonth =
                typeof lunar.getMonth === "function"
                    ? lunar.getMonth()
                    : lunar._lunarMonth || date.getMonth() + 1;

            let theme;

            // Seasonal Logic (Month-based)
            const m = date.getMonth() + 1; // 1-12
            if (m >= 2 && m <= 4) {
                theme = "theme-spring";
            } else if (m >= 5 && m <= 7) {
                theme = "theme-summer";
            } else if (m >= 8 && m <= 10) {
                theme = "theme-autumn";
            } else {
                theme = "theme-winter";
            }

            // Festival Overrides
            // Lunar New Year / Year End Atmosphere (臘月 & 正月)
            if (
                lunarMonth === 12 ||
                lunarMonth === 1 ||
                (festival && festival.includes("春節"))
            ) {
                theme = "theme-festive";
            } else if (festival && festival.includes("清明")) {
                theme = "theme-dark";
            }

            // Sync Theme to App Container for global variable propagation
            const appContainer = document.getElementById("appContainer");
            if (appContainer) {
                appContainer.classList.remove(
                    "theme-light",
                    "theme-dark",
                    "theme-festive",
                    "theme-spring",
                    "theme-summer",
                    "theme-autumn",
                    "theme-winter",
                );
                appContainer.classList.add(theme);
            }

            // Render Panels if active
            if (activePanel) {
                window.dispatchEvent(
                    new CustomEvent("render-panels", {
                        detail: {
                            type: activePanel,
                            selectedYear,
                            selectedMonth,
                            selectedDay,
                            today,
                            theme,
                        },
                    }),
                );
            }

            // Render Calendar Grid
            window.dispatchEvent(
                new CustomEvent("render-calendar", {
                    detail: {
                        year: selectedYear,
                        month: selectedMonth,
                        today,
                        selectedDay,
                        theme,
                    },
                }),
            );

            // Update Header Title (Now passing both for flexibility)
            window.dispatchEvent(
                new CustomEvent("update-calendar-title", {
                    detail: {
                        year: selectedYear,
                        month: selectedMonth,
                        day: selectedDay,
                        lunarText: {
                            ganzhi: lunar.getYearInGanZhi(),
                            month: lunar.getMonthInChinese(),
                            day: lunar.getDayInChinese(),
                        },
                    },
                }),
            );

            window.dispatchEvent(
                new CustomEvent("render-hero", {
                    detail: { date, lunar, changeBg: false },
                }),
            );

            checkAutoSlideshow();
        }

        function checkAutoSlideshow() {
            // Need to know if grid is showing.
            // We can query DOM or use a reliable state tracking if we added one.
            // Since CalendarBoard toggles the class synchronously in its listener, DOM check should be fine.
            const calendarSection = document.getElementById("calendarSection");
            const isGrid = calendarSection
                ? calendarSection.classList.contains("show-grid")
                : false;

            // User Requirement: "Only when clicking 'See Image' (No Grid, No Panel) should auto-change."
            // This translates to: SlideShow START only if (No Panel AND No Grid).
            // SlideShow STOP otherwise.
            if (!activePanel && !isGrid) {
                window.dispatchEvent(
                    new CustomEvent("slideshow-control", {
                        detail: { action: "start" },
                    }),
                );
            } else {
                window.dispatchEvent(
                    new CustomEvent("slideshow-control", {
                        detail: { action: "stop" },
                    }),
                );
            }
        }

        // --- Event Handlers (Orchestrator) ---

        // 1. Navigation
        window.addEventListener("navigate-month", (e) => {
            const dir = e.detail;
            selectedMonth += dir;
            if (selectedMonth > 11) {
                selectedMonth = 0;
                selectedYear++;
            } else if (selectedMonth < 0) {
                selectedMonth = 11;
                selectedYear--;
            }
            updateState();
        });

        window.addEventListener("go-to-today", () => {
            selectedYear = today.getFullYear();
            selectedMonth = today.getMonth();
            selectedDay = today.getDate();
            updateState();

            // Open Today Panel
            activePanel = "today";
            window.dispatchEvent(
                new CustomEvent("render-panels", {
                    detail: {
                        type: "today",
                        selectedYear,
                        selectedMonth,
                        selectedDay,
                        today,
                    },
                }),
            );
            // Close Grid?
            window.dispatchEvent(
                new CustomEvent("toggle-grid-view", {
                    detail: { show: false },
                }),
            );
        });

        // 2. Panel Interactions
        window.addEventListener("toggle-panel", (e) => {
            const type = e.detail;
            const isSamePanel = activePanel === type;

            // Close all first
            activePanel = null;
            window.dispatchEvent(new CustomEvent("hide-panels"));

            if (isSamePanel) {
                // Return to Grid
                window.dispatchEvent(
                    new CustomEvent("toggle-grid-view", {
                        detail: { show: true },
                    }),
                );
            } else {
                // Open new panel
                activePanel = type;
                window.dispatchEvent(
                    new CustomEvent("toggle-grid-view", {
                        detail: { show: false },
                    }),
                );
                window.dispatchEvent(
                    new CustomEvent("render-panels", {
                        detail: {
                            type,
                            selectedYear,
                            selectedMonth,
                            selectedDay,
                            today,
                        },
                    }),
                );
            }
            checkAutoSlideshow();
        });

        window.addEventListener("close-panels", (e) => {
            const { showGrid } = e.detail || {};
            activePanel = null;
            window.dispatchEvent(new CustomEvent("hide-panels"));
            if (showGrid !== undefined) {
                window.dispatchEvent(
                    new CustomEvent("toggle-grid-view", {
                        detail: { show: showGrid },
                    }),
                );
            }
            checkAutoSlideshow();
        });

        window.addEventListener("year-selected", (e) => {
            selectedYear = e.detail;
            updateState();
            // Re-render panel to show selection
            window.dispatchEvent(
                new CustomEvent("render-panels", {
                    detail: {
                        type: "yearMonth",
                        selectedYear,
                        selectedMonth,
                        selectedDay,
                        today,
                    },
                }),
            );
        });

        window.addEventListener("month-selected", (e) => {
            selectedMonth = e.detail;

            // Date Safety: Ensure selectedDay is valid for the new month (e.g., avoid Feb 30)
            const daysInMonth = new Date(
                selectedYear,
                selectedMonth + 1,
                0,
            ).getDate();
            if (selectedDay > daysInMonth) {
                selectedDay = daysInMonth;
            }

            updateState();

            // UX Optimization: Automatically close year/month panel and return to Grid
            window.dispatchEvent(
                new CustomEvent("close-panels", { detail: { showGrid: true } }),
            );
        });

        window.addEventListener("date-selected", (e) => {
            const { year, month, day } = e.detail;

            // UX Improvement: If clicking a day from another month, navigate to that month
            if (month !== selectedMonth || year !== selectedYear) {
                selectedYear = year;
                selectedMonth = month;
                updateState();
            }

            selectedDay = day;

            // Update Hero (background might not change unless necessary, but text updates)
            const date = new Date(selectedYear, selectedMonth, selectedDay);
            const lunar = Lunar.fromDate(date);
            window.dispatchEvent(
                new CustomEvent("render-hero", {
                    detail: { date, lunar, changeBg: false },
                }),
            );

            // Open Today Panel
            activePanel = "today";
            console.log("[Index] Dispatching toggle-grid-view (false)");
            window.dispatchEvent(
                new CustomEvent("toggle-grid-view", {
                    detail: { show: false },
                }),
            );
            console.log("[Index] Dispatching render-panels (today)");
            window.dispatchEvent(
                new CustomEvent("render-panels", {
                    detail: {
                        type: "today",
                        selectedYear,
                        selectedMonth,
                        selectedDay,
                        today,
                    },
                }),
            );
        });

        window.addEventListener("toggle-grid", () => {
            const calendarSection = document.getElementById("calendarSection");
            const isShowing = calendarSection.classList.contains("show-grid");

            activePanel = null;
            window.dispatchEvent(new CustomEvent("hide-panels"));

            window.dispatchEvent(
                new CustomEvent("toggle-grid-view", {
                    detail: { show: !isShowing },
                }),
            );
            checkAutoSlideshow();
        });

        // Init
        updateState();

        // Boutique Entrance: Start in Welcome Mode
        // 一進場立刻進入「歡迎/沉浸」狀態，避免 UI 閃爍
        document.body.classList.add("initial-welcome");
        window.dispatchEvent(
            new CustomEvent("welcome-mode", { detail: { active: true } }),
        );

        // 預設背景切換為「今日」
        activePanel = "today";
        window.dispatchEvent(
            new CustomEvent("toggle-grid-view", { detail: { show: false } }),
        );

        // 渲染今日宜忌面板 (歡迎畫面)
        window.dispatchEvent(
            new CustomEvent("render-panels", {
                detail: {
                    type: "today",
                    selectedYear,
                    selectedMonth,
                    selectedDay,
                    today,
                },
            }),
        );

        // 啟動背景圖片輪播，但此時尚未進入「映畫模式」的閒置監控
        window.dispatchEvent(
            new CustomEvent("slideshow-control", {
                detail: { action: "start", isArtwork: false },
            }),
        );

        // Listen from Hero
        window.addEventListener("request-hero-change", (e) => {
            const { changeBg, transitionOverride } = e.detail || {};
            const date = new Date(selectedYear, selectedMonth, selectedDay);
            const lunar = Lunar.fromDate(date);

            // If changeBg is true, it means user clicked "Change Image", we should probably just rotate image
            // "updateHero" in legacy code handled both text update and bg update.
            // Here we just pass it through.
            window.dispatchEvent(
                new CustomEvent("render-hero", {
                    detail: { date, lunar, changeBg, transitionOverride },
                }),
            );
        });
    </script>
</Layout>
