---
import CalendarBoard from "../components/Calendar/CalendarBoard.astro";
import HeroSection from "../components/Hero/HeroSection.astro";
import FloatingPanels from "../components/Panels/FloatingPanels.astro";
import Layout from "../layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL;
const bgUrl = `${baseUrl}/assets/gallery/winter/2.webp`.replace(/\/+/g, "/");
---

<Layout>
    <!-- Loading Overlay (Splash Screen) -->
    <div id="loadingOverlay">
        <div class="loading-content">
            <div class="loading-text" id="loadingText">農民曆</div>
        </div>
    </div>

    <style is:global define:vars={{ bgUrl: `url(${bgUrl})` }}>
        /* --- 1. Premium Loading Overlay --- */
        #loadingOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 100000;
            display: flex;
            align-items: center;
            justify-content: center;
            transition:
                clip-path 1.6s cubic-bezier(0.7, 0, 0.3, 1),
                opacity 1.2s ease-in-out;
            overflow: hidden;
            background-color: #1a1a1a;
        }

        #loadingOverlay::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: var(--bgUrl);
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            opacity: 0.7;
            filter: brightness(0.8);
            transform: scale(1.05);
            transition: transform 6s cubic-bezier(0.1, 0, 0.2, 1);
        }

        body.app-loaded #loadingOverlay::before {
            transform: scale(1.12);
        }

        body.app-loaded #loadingOverlay {
            clip-path: circle(0% at 50% 50%);
            opacity: 0;
            pointer-events: none;
        }

        .loading-content {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            z-index: 10;
            text-align: center;
            transform: translateY(-20vh);
            transition:
                opacity 0.8s ease,
                transform 1.2s cubic-bezier(0.7, 0, 0.3, 1);
        }

        body.app-loaded .loading-content {
            opacity: 0;
            transform: translateY(-25vh) scale(0.95);
        }

        .loading-text {
            font-family: "Zhi Mang Xing", cursive;
            font-size: clamp(4.5rem, 18vw, 8.5rem);
            letter-spacing: 1.8rem;
            position: relative;
            white-space: nowrap;
            line-height: 1.2;
            padding: 20px;
            background: linear-gradient(
                to right,
                #f0d060 var(--loading-progress, 0%),
                rgba(255, 255, 255, 0.4) var(--loading-progress, 0%)
            );
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            filter: drop-shadow(0 0 25px rgba(212, 175, 55, 0.4));
        }

        /* --- 2. 修正轉場：確保置中元素不移位 (Fixing Staggered Transitions) --- */

        /* 頁首標題：絕對定位元素需保持 left 50% 與 translateX(-50%) */
        /* --- 2. 修正轉場：使用更安全的屬性避免覆蓋 Transform (Safe Staggered Transitions) --- */

        /* 頁首標題：使用 top 微調而不覆蓋 transform */
        .hero-header {
            opacity: 0 !important;
            margin-top: -30px !important; /* 改用 margin 產生位移 */
            transition:
                margin-top 1.5s cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 1.5s ease-out !important;
            transition-delay: 0.2s !important;
        }
        body.app-loaded .hero-header {
            opacity: 1 !important;
            margin-top: 0 !important;
        }

        /* 底部工具欄 */
        .hero-dock-wrapper {
            opacity: 0 !important;
            margin-bottom: -50px !important; /* 改用 margin 產生位移 */
            transition:
                margin-bottom 1.6s cubic-bezier(0.1, 0.8, 0.2, 1),
                opacity 1.6s ease-out !important;
            transition-delay: 0.8s !important;
        }
        body.app-loaded .hero-dock-wrapper {
            opacity: 1 !important;
            margin-bottom: 0 !important;
        }

        /* 今日卡片：這部分還是需要 Transform，但我們確認其原始樣式就是 translate(-50%, -50%) */
        #panelToday {
            opacity: 0 !important;
            transform: translate(-50%, -48%) scale(0.98) !important;
            transition:
                opacity 1.5s ease,
                transform 1.8s cubic-bezier(0.2, 1, 0.2, 1) !important;
            transition-delay: 0.5s !important;
            visibility: visible !important;
        }

        body.app-loaded #panelToday {
            opacity: 1 !important;
            transform: translate(-50%, -50%) scale(1) !important;
        }
    </style>

    <div class="app-container" id="appContainer">
        <HeroSection />
        <FloatingPanels />
        <CalendarBoard />
    </div>

    <script src="../scripts/app/resourceLoader.ts"></script>
    <script src="../scripts/app/appController.ts"></script>
</Layout>
