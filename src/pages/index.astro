---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/Hero/HeroSection.astro";
import CalendarBoard from "../components/Calendar/CalendarBoard.astro";
import FloatingPanels from "../components/Panels/FloatingPanels.astro";
---

<Layout>
    <!-- Loading Overlay (Splash Screen) -->
    <div id="loadingOverlay">
        <div class="loading-content">
            <div class="loading-text">農民曆</div>
            <div class="loading-bar-container">
                <div class="loading-bar" id="loadingBar"></div>
            </div>
            <div class="loading-percent" id="loadingPercent">0%</div>
        </div>
    </div>

    <style>
        /* Critical CSS for Loading Screen */
        #loadingOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .loading-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .loading-text {
            font-family: "Zhi Mang Xing", cursive;
            font-size: 3.5rem;
            letter-spacing: 0.5rem;
            color: #d4af37;
            opacity: 0.8;
            animation: pulseText 2s infinite ease-in-out;
            text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
            white-space: nowrap;
        }

        .loading-bar-container {
            width: 200px;
            height: 3px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 3px;
            overflow: hidden;
        }

        .loading-bar {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #d4af37, #f0d060);
            border-radius: 3px;
            transition: width 0.3s ease-out;
        }

        .loading-percent {
            font-family: "Playfair Display", serif;
            font-size: 1rem;
            color: rgba(212, 175, 55, 0.7);
            letter-spacing: 0.1rem;
        }

        @keyframes pulseText {
            0%,
            100% {
                opacity: 0.6;
                transform: scale(0.98);
            }
            50% {
                opacity: 1;
                transform: scale(1.02);
            }
        }

        /* App Reveal State */
        body.app-loaded #loadingOverlay {
            opacity: 0;
            pointer-events: none;
        }

        /* Initial Hidden State for UI Elements only (Background stays visible) */
        .hero-dock-wrapper,
        .hero-header,
        .suspension-panel,
        #calendarSection {
            opacity: 0;
            transition: opacity 1s ease-out;
        }

        body.app-loaded .hero-dock-wrapper,
        body.app-loaded .hero-header,
        body.app-loaded .suspension-panel,
        body.app-loaded #calendarSection {
            opacity: 1;
        }
    </style>

    <div class="app-container" id="appContainer">
        <!-- Components -->
        <HeroSection />
        <FloatingPanels />
        <CalendarBoard />
    </div>

    <script is:inline>
        // ============================================================
        // Resource Loading & Splash Screen Logic
        // MODE: dev (本地端) — 實際追蹤資源載入進度百分比
        // TODO [deploy]: GitHub Pages 部署時可調整 fallback 邏輯
        // ============================================================
        (function () {
            let isLoaded = false;
            const loadingBar = document.getElementById("loadingBar");
            const loadingPercent = document.getElementById("loadingPercent");

            // --- 資源追蹤器 ---
            // 權重分配: scripts 20%, fonts 20%, hero images 50%, audio 10%
            const progress = {
                scripts: false,   // 20%
                fonts: false,     // 20%
                heroFirst: false, // 30% (第一張背景圖)
                heroAll: false,   // 20% (其餘背景圖預載)
                audio: false,     // 10%
            };
            const weights = {
                scripts: 20,
                fonts: 20,
                heroFirst: 30,
                heroAll: 20,
                audio: 10,
            };

            function calcPercent() {
                let total = 0;
                for (const key in progress) {
                    if (progress[key]) total += weights[key];
                }
                return total;
            }

            function updateUI() {
                const pct = calcPercent();
                if (loadingBar) loadingBar.style.width = pct + "%";
                if (loadingPercent) loadingPercent.textContent = pct + "%";

                if (pct >= 100) {
                    revealApp();
                }
            }

            function markDone(key) {
                if (!progress[key]) {
                    progress[key] = true;
                    console.log("[Loader] ✓ " + key + " (" + calcPercent() + "%)");
                    updateUI();
                }
            }

            function revealApp() {
                if (isLoaded) return;
                isLoaded = true;

                document.body.classList.add("app-loaded");

                setTimeout(() => {
                    const overlay = document.getElementById("loadingOverlay");
                    if (overlay) overlay.style.display = "none";
                }, 1000);
            }

            // --- 1. 檢查 Scripts (Lunar + GALLERY_MANIFEST) ---
            function checkScripts() {
                if (typeof Lunar !== "undefined" && typeof GALLERY_MANIFEST !== "undefined") {
                    markDone("scripts");
                    return true;
                }
                return false;
            }

            // --- 2. 檢查 Fonts ---
            function checkFonts() {
                if (document.fonts && document.fonts.status === "loaded") {
                    markDone("fonts");
                    return true;
                }
                return false;
            }

            // --- 3. 預載 Hero 圖片 ---
            function preloadHeroImages() {
                if (typeof GALLERY_MANIFEST === "undefined") return;

                // 決定當季
                const m = new Date().getMonth() + 1;
                let season;
                if (m >= 2 && m <= 4) season = "spring";
                else if (m >= 5 && m <= 7) season = "summer";
                else if (m >= 8 && m <= 10) season = "autumn";
                else season = "winter";

                const baseDir = window.APP_BASE_URL || "/";
                const galleryDir = (baseDir + "assets/gallery/" + season + "/").replace(/\/+/g, "/");

                let imageList = (GALLERY_MANIFEST[season] || []).map(f => galleryDir + f);
                // fallback to default
                if (imageList.length === 0) {
                    const defaultDir = (baseDir + "assets/gallery/default/").replace(/\/+/g, "/");
                    imageList = (GALLERY_MANIFEST["default"] || []).map(f => defaultDir + f);
                }

                if (imageList.length === 0) {
                    markDone("heroFirst");
                    markDone("heroAll");
                    return;
                }

                // 載入第一張 (權重最高)
                const firstImg = new Image();
                firstImg.onload = firstImg.onerror = () => {
                    markDone("heroFirst");
                };
                firstImg.src = imageList[0];

                // 載入其餘
                if (imageList.length <= 1) {
                    markDone("heroAll");
                } else {
                    let remaining = imageList.length - 1;
                    let loaded = 0;
                    for (let i = 1; i < imageList.length; i++) {
                        const img = new Image();
                        img.onload = img.onerror = () => {
                            loaded++;
                            if (loaded >= remaining) {
                                markDone("heroAll");
                            }
                        };
                        img.src = imageList[i];
                    }
                }
            }

            // --- 4. 預載 Audio ---
            function preloadAudio() {
                const baseDir = window.APP_BASE_URL || "/";
                const audioFiles = [
                    (baseDir + "assets/audio/ambient.mp3").replace(/\/+/g, "/"),
                ];
                // 只測試第一個音頻是否可載入
                if (audioFiles.length === 0) {
                    markDone("audio");
                    return;
                }
                const audio = new Audio();
                audio.preload = "auto";
                // [dev] 本地端音頻載入通常很快
                audio.oncanplaythrough = () => markDone("audio");
                audio.onerror = () => markDone("audio"); // 即使失敗也不阻塞
                audio.src = audioFiles[0];

                // [dev] 音頻 fallback 超時 2 秒
                setTimeout(() => markDone("audio"), 2000);
            }

            // --- 主邏輯 ---
            window.addEventListener("load", () => {
                // 立即檢查 scripts
                if (!checkScripts()) {
                    const si = setInterval(() => {
                        if (checkScripts()) clearInterval(si);
                    }, 50);
                }

                // 字體
                if (!checkFonts()) {
                    document.fonts.ready.then(() => markDone("fonts"));
                    // fallback
                    setTimeout(() => markDone("fonts"), 3000);
                }

                // 圖片 — 等 scripts ready 後才知道 manifest
                const waitManifest = setInterval(() => {
                    if (progress.scripts) {
                        clearInterval(waitManifest);
                        preloadHeroImages();
                    }
                }, 50);

                // 音頻
                preloadAudio();

                // [dev] 安全網：最多等 8 秒強制進入
                // TODO [deploy]: GitHub Pages 可能需要更長時間，可調整此值
                setTimeout(() => {
                    for (const key in progress) {
                        if (!progress[key]) {
                            console.warn("[Loader] Force-completing: " + key);
                            progress[key] = true;
                        }
                    }
                    updateUI();
                }, 8000);
            });
        })();
    </script>

    <script is:inline>
        // State Management
        let selectedYear = new Date().getFullYear();
        let selectedMonth = new Date().getMonth();
        let selectedDay = new Date().getDate();
        const today = new Date();
        let activePanel = null;

        // --- Core Functions ---

        function updateState() {
            const date = new Date(selectedYear, selectedMonth, selectedDay);
            const lunar = Lunar.fromDate(date);
            const festival = lunar.getFestival();
            const lunarMonth =
                typeof lunar.getMonth === "function"
                    ? lunar.getMonth()
                    : lunar._lunarMonth || date.getMonth() + 1;

            let theme;

            // Seasonal Logic (Month-based)
            const m = date.getMonth() + 1; // 1-12
            if (m >= 2 && m <= 4) {
                theme = "theme-spring";
            } else if (m >= 5 && m <= 7) {
                theme = "theme-summer";
            } else if (m >= 8 && m <= 10) {
                theme = "theme-autumn";
            } else {
                theme = "theme-winter";
            }

            // Festival Overrides
            // Lunar New Year / Year End Atmosphere (臘月 & 正月)
            if (
                lunarMonth === 12 ||
                lunarMonth === 1 ||
                (festival && festival.includes("春節"))
            ) {
                theme = "theme-festive";
            } else if (festival && festival.includes("清明")) {
                theme = "theme-dark";
            }

            // Sync Theme to App Container for global variable propagation
            const appContainer = document.getElementById("appContainer");
            if (appContainer) {
                appContainer.classList.remove(
                    "theme-light",
                    "theme-dark",
                    "theme-festive",
                    "theme-spring",
                    "theme-summer",
                    "theme-autumn",
                    "theme-winter",
                );
                appContainer.classList.add(theme);
            }

            // Render Panels if active
            if (activePanel) {
                window.dispatchEvent(
                    new CustomEvent("render-panels", {
                        detail: {
                            type: activePanel,
                            selectedYear,
                            selectedMonth,
                            selectedDay,
                            today,
                            theme,
                        },
                    }),
                );
            }

            // Render Calendar Grid
            window.dispatchEvent(
                new CustomEvent("render-calendar", {
                    detail: {
                        year: selectedYear,
                        month: selectedMonth,
                        today,
                        selectedDay,
                        theme,
                    },
                }),
            );

            // Update Header Title (Now passing both for flexibility)
            window.dispatchEvent(
                new CustomEvent("update-calendar-title", {
                    detail: {
                        year: selectedYear,
                        month: selectedMonth,
                        day: selectedDay,
                        lunarText: {
                            ganzhi: lunar.getYearInGanZhi(),
                            month: lunar.getMonthInChinese(),
                            day: lunar.getDayInChinese(),
                        },
                    },
                }),
            );

            window.dispatchEvent(
                new CustomEvent("render-hero", {
                    detail: { date, lunar, changeBg: false },
                }),
            );

            checkAutoSlideshow();
        }

        function checkAutoSlideshow() {
            // Need to know if grid is showing.
            // We can query DOM or use a reliable state tracking if we added one.
            // Since CalendarBoard toggles the class synchronously in its listener, DOM check should be fine.
            const calendarSection = document.getElementById("calendarSection");
            const isGrid = calendarSection
                ? calendarSection.classList.contains("show-grid")
                : false;

            // User Requirement: "Only when clicking 'See Image' (No Grid, No Panel) should auto-change."
            // This translates to: SlideShow START only if (No Panel AND No Grid).
            // SlideShow STOP otherwise.
            if (!activePanel && !isGrid) {
                window.dispatchEvent(
                    new CustomEvent("slideshow-control", {
                        detail: { action: "start" },
                    }),
                );
            } else {
                window.dispatchEvent(
                    new CustomEvent("slideshow-control", {
                        detail: { action: "stop" },
                    }),
                );
            }
        }

        // --- Event Handlers (Orchestrator) ---

        // 1. Navigation
        window.addEventListener("navigate-month", (e) => {
            const dir = e.detail;
            selectedMonth += dir;
            if (selectedMonth > 11) {
                selectedMonth = 0;
                selectedYear++;
            } else if (selectedMonth < 0) {
                selectedMonth = 11;
                selectedYear--;
            }
            updateState();
        });

        window.addEventListener("go-to-today", () => {
            selectedYear = today.getFullYear();
            selectedMonth = today.getMonth();
            selectedDay = today.getDate();
            updateState();

            // Open Today Panel
            activePanel = "today";
            window.dispatchEvent(
                new CustomEvent("render-panels", {
                    detail: {
                        type: "today",
                        selectedYear,
                        selectedMonth,
                        selectedDay,
                        today,
                    },
                }),
            );
            // Close Grid?
            window.dispatchEvent(
                new CustomEvent("toggle-grid-view", {
                    detail: { show: false },
                }),
            );
        });

        // 2. Panel Interactions
        window.addEventListener("toggle-panel", (e) => {
            const type = e.detail;
            const isSamePanel = activePanel === type;

            // Close all first
            activePanel = null;
            window.dispatchEvent(new CustomEvent("hide-panels"));

            if (isSamePanel) {
                // Return to Grid
                window.dispatchEvent(
                    new CustomEvent("toggle-grid-view", {
                        detail: { show: true },
                    }),
                );
            } else {
                // Open new panel
                activePanel = type;
                window.dispatchEvent(
                    new CustomEvent("toggle-grid-view", {
                        detail: { show: false },
                    }),
                );
                window.dispatchEvent(
                    new CustomEvent("render-panels", {
                        detail: {
                            type,
                            selectedYear,
                            selectedMonth,
                            selectedDay,
                            today,
                        },
                    }),
                );
            }
            checkAutoSlideshow();
        });

        window.addEventListener("close-panels", (e) => {
            const { showGrid } = e.detail || {};
            activePanel = null;
            window.dispatchEvent(new CustomEvent("hide-panels"));
            if (showGrid !== undefined) {
                window.dispatchEvent(
                    new CustomEvent("toggle-grid-view", {
                        detail: { show: showGrid },
                    }),
                );
            }
            checkAutoSlideshow();
        });

        window.addEventListener("year-selected", (e) => {
            selectedYear = e.detail;
            updateState();
            // Re-render panel to show selection
            window.dispatchEvent(
                new CustomEvent("render-panels", {
                    detail: {
                        type: "yearMonth",
                        selectedYear,
                        selectedMonth,
                        selectedDay,
                        today,
                    },
                }),
            );
        });

        window.addEventListener("month-selected", (e) => {
            selectedMonth = e.detail;

            // Date Safety: Ensure selectedDay is valid for the new month (e.g., avoid Feb 30)
            const daysInMonth = new Date(
                selectedYear,
                selectedMonth + 1,
                0,
            ).getDate();
            if (selectedDay > daysInMonth) {
                selectedDay = daysInMonth;
            }

            updateState();

            // UX Optimization: Automatically close year/month panel and return to Grid
            window.dispatchEvent(
                new CustomEvent("close-panels", { detail: { showGrid: true } }),
            );
        });

        window.addEventListener("date-selected", (e) => {
            const { year, month, day } = e.detail;

            // UX Improvement: If clicking a day from another month, navigate to that month
            if (month !== selectedMonth || year !== selectedYear) {
                selectedYear = year;
                selectedMonth = month;
                updateState();
            }

            selectedDay = day;

            // Update Hero (background might not change unless necessary, but text updates)
            const date = new Date(selectedYear, selectedMonth, selectedDay);
            const lunar = Lunar.fromDate(date);
            window.dispatchEvent(
                new CustomEvent("render-hero", {
                    detail: { date, lunar, changeBg: false },
                }),
            );

            // Open Today Panel
            activePanel = "today";
            console.log("[Index] Dispatching toggle-grid-view (false)");
            window.dispatchEvent(
                new CustomEvent("toggle-grid-view", {
                    detail: { show: false },
                }),
            );
            console.log("[Index] Dispatching render-panels (today)");
            window.dispatchEvent(
                new CustomEvent("render-panels", {
                    detail: {
                        type: "today",
                        selectedYear,
                        selectedMonth,
                        selectedDay,
                        today,
                    },
                }),
            );
        });

        window.addEventListener("toggle-grid", () => {
            const calendarSection = document.getElementById("calendarSection");
            const isShowing = calendarSection.classList.contains("show-grid");

            activePanel = null;
            window.dispatchEvent(new CustomEvent("hide-panels"));

            window.dispatchEvent(
                new CustomEvent("toggle-grid-view", {
                    detail: { show: !isShowing },
                }),
            );
            checkAutoSlideshow();
        });

        // Init
        updateState();

        // ============================================================
        // Welcome Mode: 等待載入完成 (100%) 才進入歡迎頁面
        // [dev] 本地端：監聽 body.app-loaded 確認資源已全部載入
        // TODO [deploy]: GitHub Pages 部署時邏輯相同，無需調整
        // ============================================================
        function enterWelcomeMode() {
            // 一進場立刻進入「歡迎/沉浸」狀態
            document.body.classList.add("initial-welcome");
            window.dispatchEvent(
                new CustomEvent("welcome-mode", { detail: { active: true } }),
            );

            activePanel = "today";
            window.dispatchEvent(
                new CustomEvent("toggle-grid-view", { detail: { show: false } }),
            );

            // 渲染今日宜忌面板 (歡迎畫面)
            window.dispatchEvent(
                new CustomEvent("render-panels", {
                    detail: {
                        type: "today",
                        selectedYear,
                        selectedMonth,
                        selectedDay,
                        today,
                    },
                }),
            );

            // 啟動背景圖片輪播（非映畫模式）
            window.dispatchEvent(
                new CustomEvent("slideshow-control", {
                    detail: { action: "start", isArtwork: false },
                }),
            );
        }

        // 當載入完成才進入歡迎頁面
        if (document.body.classList.contains("app-loaded")) {
            enterWelcomeMode();
        } else {
            const loadObserver = new MutationObserver((mutations) => {
                for (const m of mutations) {
                    if (m.attributeName === "class" && document.body.classList.contains("app-loaded")) {
                        loadObserver.disconnect();
                        enterWelcomeMode();
                        break;
                    }
                }
            });
            loadObserver.observe(document.body, { attributes: true });
        }

        // Listen from Hero
        window.addEventListener("request-hero-change", (e) => {
            const { changeBg, transitionOverride } = e.detail || {};
            const date = new Date(selectedYear, selectedMonth, selectedDay);
            const lunar = Lunar.fromDate(date);

            // If changeBg is true, it means user clicked "Change Image", we should probably just rotate image
            // "updateHero" in legacy code handled both text update and bg update.
            // Here we just pass it through.
            window.dispatchEvent(
                new CustomEvent("render-hero", {
                    detail: { date, lunar, changeBg, transitionOverride },
                }),
            );
        });
    </script>
</Layout>
