---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/Hero/HeroSection.astro";
import CalendarBoard from "../components/Calendar/CalendarBoard.astro";
import FloatingPanels from "../components/Panels/FloatingPanels.astro";
---

<Layout>
    <!-- Loading Overlay (Splash Screen) -->
    <div id="loadingOverlay">
        <div class="loading-content">
            <div class="loading-text">農民曆</div>
            <div class="loading-bar-container">
                <div class="loading-bar" id="loadingBar"></div>
            </div>
            <div class="loading-percent" id="loadingPercent">0%</div>
        </div>
    </div>

    <style>
        /* Critical CSS for Loading Screen */
        #loadingOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .loading-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .loading-text {
            font-family: "Zhi Mang Xing", cursive;
            font-size: 3.5rem;
            letter-spacing: 0.5rem;
            color: #d4af37;
            opacity: 0.8;
            animation: pulseText 2s infinite ease-in-out;
            text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
            white-space: nowrap;
        }

        .loading-bar-container {
            width: 200px;
            height: 3px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 3px;
            overflow: hidden;
        }

        .loading-bar {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #d4af37, #f0d060);
            border-radius: 3px;
            transition: width 0.3s ease-out;
        }

        .loading-percent {
            font-family: "Playfair Display", serif;
            font-size: 1rem;
            color: rgba(212, 175, 55, 0.7);
            letter-spacing: 0.1rem;
        }

        @keyframes pulseText {
            0%,
            100% {
                opacity: 0.6;
                transform: scale(0.98);
            }
            50% {
                opacity: 1;
                transform: scale(1.02);
            }
        }

        /* App Reveal State */
        body.app-loaded #loadingOverlay {
            opacity: 0;
            pointer-events: none;
        }

        /* Initial Hidden State for UI Elements only (Background stays visible) */
        .hero-dock-wrapper,
        .hero-header,
        .suspension-panel,
        #calendarSection {
            opacity: 0;
            transition: opacity 1s ease-out;
        }

        body.app-loaded .hero-dock-wrapper,
        body.app-loaded .hero-header,
        body.app-loaded .suspension-panel,
        body.app-loaded #calendarSection {
            opacity: 1;
        }
    </style>

    <div class="app-container" id="appContainer">
        <!-- Components -->
        <HeroSection />
        <FloatingPanels />
        <CalendarBoard />
    </div>

    <script src="../scripts/app/resourceLoader.js"></script>
    <script src="../scripts/app/appController.js"></script>
</Layout>
