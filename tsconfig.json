{
    "extends": "astro/tsconfigs/strictest",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "types": [
            "vite-plugin-pwa/info"
        ],
        "allowJs": true,
        "checkJs": true
    },
    "exclude": [
        "node_modules",
        "dist",
        ".astro",
        "archive",
        "scripts",
        "eslint.config.js",
        "tailwind.config.mjs"
    ]
}